---
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { ClientRouter } from 'astro:transitions';
import { NOINDEX, site } from '../config';

interface Props {
  /** Título de la pestaña. Si no incluye "Districo S.A." se le agrega al final. */
  title: string;
  description?: string;
  /** Imagen de preview al compartir. Ruta absoluta del sitio, ej '/og.png'. */
  image?: string;
  ogType?: 'website' | 'article' | 'product';
}
const { title, description = site.tagline, image = site.ogImage, ogType = 'website' } = Astro.props;

const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;
// Astro.site sale de `site` en astro.config.mjs: al mudar el dominio se cambia ahí.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es-UY" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Fuera de buscadores mientras el sitio esté en Vercel.
        "follow" a propósito: los asistentes de IA que sí pueden leer el sitio
        (ver src/pages/robots.txt.ts) necesitan seguir los enlaces internos.
        Se apaga con NOINDEX = false en src/config.ts. */}
    {NOINDEX && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="es_UY" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#06262C" />

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />

    <script>
      // Fade-in + slide-up al entrar en viewport. Un solo observer para todo el documento.
      // Corre igual con prefers-reduced-motion: reduce, y a propósito. Bajo esa
      // preferencia global.css pone --reveal-shift en 0px, así que lo que queda
      // es un fade puro, sin desplazamiento: la entrada se conserva como
      // sustituto del movimiento en vez de desaparecer. Por eso acá no hay
      // ningún matchMedia: el CSS ya decide, y una rama en JS solo podría
      // desincronizarse con él.
      //
      // Va colgado de astro:page-load y no del arranque del módulo: con el
      // ClientRouter el módulo se evalúa una sola vez en toda la sesión, así
      // que un observer creado al arrancar solo vería los elementos de la
      // primera página y todo lo que se navegara después quedaría en
      // opacidad 0. astro:page-load también dispara en la carga inicial.
      let navegacionCliente = false;
      let revelador: IntersectionObserver | null = null;
      let salidaActual: Animation | null = null;

      const animarSalida = async (signal: AbortSignal) => {
        const contenido = document.getElementById('main');
        if (!contenido || signal.aborted) return;

        // La página siguiente ya está preparada cuando llegamos acá: el fade
        // nunca deja una pantalla vacía esperando red. También cancela una
        // entrada anterior si el usuario navega rápidamente entre páginas.
        for (const animacion of contenido.getAnimations()) animacion.cancel();
        contenido.classList.remove('page-enter', 'page-exit');
        void contenido.offsetWidth;
        contenido.classList.add('page-exit');

        const animacion = contenido.getAnimations().at(-1) ?? null;
        if (!animacion) return;
        salidaActual = animacion;

        const cancelar = () => {
          animacion.cancel();
          contenido.classList.remove('page-exit');
        };
        signal.addEventListener('abort', cancelar, { once: true });

        try {
          await animacion.finished;
        } catch {
          // Cancelar una navegación rechaza `finished`; es el comportamiento
          // esperado y no debe dejar la página actual atenuada.
        } finally {
          signal.removeEventListener('abort', cancelar);
          if (salidaActual === animacion) salidaActual = null;
        }
      };

      document.addEventListener('astro:before-preparation', (event) => {
        navegacionCliente = true;

        // Astro carga primero la ruta en segundo plano y recién entonces hace
        // la salida de 120 ms. Así se obtiene un fade real entre páginas sin
        // reintroducir la capa estática de View Transitions que bloqueaba los
        // clics en la versión anterior.
        const cargar = event.loader;
        event.loader = async () => {
          await cargar();
          await animarSalida(event.signal);
        };
      });

      document.addEventListener('astro:before-swap', (event) => {
        revelador?.disconnect();
        revelador = null;
        // La página nueva ya entra al DOM con su estado inicial de opacidad.
        // Poner la clase antes del swap evita incluso un frame a opacidad 1
        // entre el reemplazo del documento y `astro:page-load`.
        event.newDocument.getElementById('main')?.classList.add('page-enter');
      });

      // Fade de entrada del contenido. Va sobre el <main> real y no sobre los
      // pseudo-elementos de View Transitions: esa capa es una captura estática
      // que no acepta clics, así que el fade bloqueaba la página mientras
      // corría. Por eso el <html> lleva transition:animate="none", que deja el
      // swap inmediato, y la animación la hace el CSS sobre el DOM montado.
      document.addEventListener('astro:page-load', () => {
        const contenido = document.getElementById('main');
        if (!contenido) return;
        salidaActual = null;

        // En navegación cliente before-swap ya dejó preparada la entrada. La
        // carga inicial no pasa por ese evento, así que la inicia desde acá.
        if (contenido.classList.contains('page-enter')) return;
        // Navegar durante un fade cancela el anterior. Al cancelarse, la
        // opacidad vuelve al 1 que tiene el <main> por CSS, así que encadenar
        // navegaciones rápidas no puede dejar ninguna página a medio camino.
        for (const a of contenido.getAnimations()) a.cancel();
        contenido.classList.remove('page-enter', 'page-exit');
        // Lectura forzada: sin esto el navegador junta el quitar y el poner en
        // el mismo estilo calculado y la animación no vuelve a arrancar.
        void contenido.offsetWidth;
        contenido.classList.add('page-enter');
      });

      document.addEventListener('astro:page-load', () => {
        revelador?.disconnect();
        revelador = null;
        let items = [...document.querySelectorAll('[data-reveal]:not(.is-visible)')];

        // En una navegación con el router, lo que ya está en pantalla no se
        // revela: la entrada de página acaba de traerlo. Encadenar los dos
        // fades dejaría una espera innecesaria antes de poder leer la página.
        if (navegacionCliente) {
          const yaVisibles = items.filter((el) => el.getBoundingClientRect().top < window.innerHeight);
          for (const el of yaVisibles) {
            (el as HTMLElement).style.transition = 'none';
            el.classList.add('is-visible');
          }
          requestAnimationFrame(() => {
            for (const el of yaVisibles) (el as HTMLElement).style.transition = '';
          });
          items = items.filter((el) => !el.classList.contains('is-visible'));
        }

        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
          );
          items.forEach((el) => io.observe(el));
          revelador = io;
        } else {
          items.forEach((el) => el.classList.add('is-visible'));
        }
      });
    </script>
  </body>
</html>
