---
import Button from './Button.astro';
import { contactLink, site } from '../config';
---

<section class="cta on-dark">
  <div class="container cta__inner" data-reveal>
    <span class="blob cta__blob" aria-hidden="true"></span>
    <div class="cta__text">
      <span class="kicker kicker--onDark">Cuenta comercial</span>
      <h2 class="title-xl">¿Tenés una veterinaria o pet shop?</h2>
      <p>
        Contactanos para conocer las condiciones de distribución, el catálogo vigente y la
        cobertura de reparto en tu zona.
      </p>
    </div>
    <div class="cta__actions">
      <Button href={contactLink('Hola, quisiera abrir una cuenta mayorista con Districo.')} variant="lime" size="lg">
        Escribir por WhatsApp
      </Button>
      <Button href="/contacto" variant="outline" size="lg">Formulario de contacto</Button>
      <a class="cta__mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--teal-950); color: var(--white); padding-block: var(--section-y-sm); overflow: hidden; }
  .cta__inner { position: relative; display: grid; gap: 2rem; align-items: center; }
  .cta__blob { width: 340px; aspect-ratio: 1; background: var(--teal-700); top: -40%; right: -12%; opacity: 0.55; }
  .cta__text { position: relative; z-index: 1; }
  .cta__text > * + * { margin-top: 1rem; }
  .cta__text .kicker { display: block; }
  .cta__text h2 { max-width: 18ch; }
  .cta__text p { color: rgb(255 255 255 / 0.72); max-width: 52ch; font-size: var(--text-lg); }

  /* En columna: los botones comparten borde y no quedan escalonados al envolver. */
  .cta__actions {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 0.75rem;
  }
  .cta__actions :global(.btn) { width: 100%; justify-content: center; max-width: 22rem; }
  .cta__mail { color: var(--lime-500); font-weight: 600; text-decoration: none; }
  .cta__mail:hover { text-decoration: underline; }

  @media (min-width: 940px) {
    .cta__inner { grid-template-columns: 1.1fr 0.9fr; gap: 3rem; }
    .cta__actions { justify-items: end; }
    .cta__mail { align-self: end; }
  }
</style>
