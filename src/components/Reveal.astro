---
// Envuelve el contenido en un contenedor que hace fade-in + slide-up al entrar en viewport.
interface Props { delay?: number; as?: string; class?: string; }
const { delay = 0, as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag data-reveal class={className} style={delay ? `--reveal-delay:${delay}ms` : undefined}>
  <slot />
</Tag>
