---
interface Hito {
  year: string;
  title: string;
  description: string;
}

interface Props {
  hitos: Hito[];
}

const { hitos } = Astro.props;
---

<div class="timeline" data-timeline data-reveal>
  <div class="timeline__nav">
    <button
      class="timeline__arrow"
      type="button"
      data-timeline-step="-1"
      aria-label="Hito anterior"
      hidden
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>

    <ol class="timeline__years" data-timeline-years aria-label="Años de la historia de Districo">
      {hitos.map((hito, i) => (
        <li>
          <a
            class="timeline__year"
            href={`#hito-${hito.year}`}
            id={`hito-tab-${hito.year}`}
            data-timeline-tab
            data-index={i}
          >
            <span aria-hidden="true"></span>
            {hito.year}
          </a>
        </li>
      ))}
    </ol>

    <button
      class="timeline__arrow"
      type="button"
      data-timeline-step="1"
      aria-label="Hito siguiente"
      hidden
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  <ol class="timeline__panels" data-timeline-panels aria-label="Hitos de la empresa">
    {hitos.map((hito, i) => (
      <li
        class="timeline__panel"
        id={`hito-${hito.year}`}
        data-timeline-panel
        data-index={i}
      >
        <span class="timeline__number" aria-hidden="true">
          {String(i + 1).padStart(2, '0')} / {String(hitos.length).padStart(2, '0')}
        </span>
        <time datetime={hito.year}>{hito.year}</time>
        <div>
          <h3>{hito.title}</h3>
          <p>{hito.description}</p>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  let desmontar: (() => void) | null = null;
  const limpiar = () => { desmontar?.(); desmontar = null; };
  document.addEventListener('astro:before-swap', limpiar);

  document.addEventListener('astro:page-load', () => {
    limpiar();

    const raiz = document.querySelector<HTMLElement>('[data-timeline]');
    const pista = raiz?.querySelector<HTMLOListElement>('[data-timeline-panels]');
    const guia = raiz?.querySelector<HTMLOListElement>('[data-timeline-years]');
    if (!raiz || !pista || !guia) return;

    // TypeScript no conserva el estrechamiento de las guardas dentro de las
    // funciones declaradas más abajo; estas referencias ya son no nulas.
    const pistaTimeline = pista;
    const guiaTimeline = guia;

    const tabs = [...raiz.querySelectorAll<HTMLAnchorElement>('[data-timeline-tab]')];
    const paneles = [...raiz.querySelectorAll<HTMLElement>('[data-timeline-panel]')];
    const flechas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-timeline-step]')];
    if (!tabs.length || tabs.length !== paneles.length) return;

    const ac = new AbortController();
    const on = { signal: ac.signal };
    let activo = 0;
    let reposo = 0;

    raiz.classList.add('is-enhanced');
    guia.setAttribute('role', 'tablist');
    for (const flecha of flechas) flecha.hidden = false;

    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', paneles[i].id);
    });
    paneles.forEach((panel, i) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[i].id);
    });

    const ancho = () => pistaTimeline.clientWidth;

    function centrarAnio(i: number) {
      const tab = tabs[i];
      const left = tab.offsetLeft - (guiaTimeline.clientWidth - tab.offsetWidth) / 2;
      guiaTimeline.scrollTo({ left: Math.max(0, left), behavior: 'auto' });
    }

    function pintar(i: number, centrar = true) {
      activo = Math.min(Math.max(i, 0), tabs.length - 1);
      tabs.forEach((tab, j) => {
        tab.setAttribute('aria-selected', String(j === activo));
        tab.tabIndex = j === activo ? 0 : -1;
      });
      paneles.forEach((panel, j) => panel.setAttribute('aria-hidden', String(j !== activo)));
      flechas[0].disabled = activo === 0;
      flechas[1].disabled = activo === tabs.length - 1;
      if (centrar) centrarAnio(activo);
    }

    function irA(i: number, moverFoco = false) {
      const destino = Math.min(Math.max(i, 0), tabs.length - 1);
      pistaTimeline.scrollTo({ left: destino * ancho(), behavior: 'auto' });
      pintar(destino);
      if (moverFoco) tabs[destino].focus({ preventScroll: true });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        irA(i);
      }, on);
      tab.addEventListener('keydown', (event) => {
        let destino: number | null = null;
        if (event.key === 'ArrowRight') destino = activo + 1;
        else if (event.key === 'ArrowLeft') destino = activo - 1;
        else if (event.key === 'Home') destino = 0;
        else if (event.key === 'End') destino = tabs.length - 1;
        if (destino === null) return;
        event.preventDefault();
        irA(destino, true);
      }, on);
    });

    flechas.forEach((flecha) => {
      flecha.addEventListener('click', () => irA(activo + Number(flecha.dataset.timelineStep)), on);
    });

    pistaTimeline.addEventListener('scroll', () => {
      window.clearTimeout(reposo);
      reposo = window.setTimeout(() => {
        const paso = ancho();
        if (paso > 0) pintar(Math.round(pistaTimeline.scrollLeft / paso));
      }, 100);
    }, { ...on, passive: true });

    const ro = new ResizeObserver(() => {
      pistaTimeline.scrollTo({ left: activo * ancho(), behavior: 'instant' });
      centrarAnio(activo);
    });
    ro.observe(pistaTimeline);

    pintar(0, false);
    pistaTimeline.scrollTo({ left: 0, behavior: 'instant' });
    desmontar = () => {
      window.clearTimeout(reposo);
      ro.disconnect();
      ac.abort();
    };
  });
</script>

<style>
  .timeline { min-width: 0; }
  .timeline__nav {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    gap: 0.6rem;
    align-items: center;
  }
  .timeline__arrow {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: var(--bd) solid var(--border);
    border-radius: 50%;
    background: var(--white);
    color: var(--teal-800);
    cursor: pointer;
    transition: color var(--dur-fast), background-color var(--dur-fast), border-color var(--dur-fast), transform var(--dur-fast);
  }
  .timeline__arrow:hover:not(:disabled) {
    border-color: var(--teal-800);
    background: var(--teal-800);
    color: var(--white);
    transform: translateY(var(--move-lift));
  }
  .timeline__arrow:disabled { opacity: 0.35; cursor: default; }

  .timeline__years {
    position: relative;
    display: flex;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: var(--scroll-carousel);
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
    padding: 0;
  }
  .timeline__years::-webkit-scrollbar,
  .timeline__panels::-webkit-scrollbar { display: none; }
  .timeline__years li {
    position: relative;
    flex: 0 0 5.4rem;
    scroll-snap-align: center;
  }
  .timeline__years li::before {
    content: '';
    position: absolute;
    top: 1.35rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--border);
  }
  .timeline__year {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 4.5rem;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.42rem;
    padding: 0.82rem 0.25rem 0.25rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition: color var(--dur-fast);
  }
  .timeline__year span {
    width: 0.82rem;
    height: 0.82rem;
    border: 3px solid var(--white);
    border-radius: 50%;
    background: var(--gray-400);
    box-shadow: 0 0 0 2px var(--gray-400);
    transition: background-color var(--dur-fast), box-shadow var(--dur-fast), scale var(--dur-fast);
  }
  .timeline__year:hover { color: var(--teal-700); }
  .timeline__year:focus-visible { outline: none; box-shadow: none; }
  .timeline__year:focus-visible span {
    box-shadow: 0 0 0 3px var(--teal-950), 0 0 0 7px var(--lime-500);
  }
  .timeline__year[aria-selected='true'] { color: var(--teal-800); }
  .timeline__year[aria-selected='true'] span {
    background: var(--lime-500);
    box-shadow: 0 0 0 3px var(--teal-800);
    scale: var(--move-zoom);
  }

  .timeline__panels {
    display: flex;
    width: 100%;
    margin-top: 1.25rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: var(--scroll-carousel);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    padding: 0;
  }
  .timeline__panel {
    position: relative;
    display: grid;
    min-width: 100%;
    min-height: 14rem;
    align-content: center;
    gap: 0.7rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    overflow: hidden;
    border: var(--bd) solid var(--border);
    border-top: 0.35rem solid var(--lime-500);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--bg-soft);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .timeline__panel time {
    color: var(--teal-700);
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }
  .timeline__panel h3 {
    max-width: 30ch;
    margin-bottom: 0.55rem;
    font-size: var(--text-xl);
  }
  .timeline__panel p { max-width: 62ch; color: var(--fg-muted); }
  .timeline__number {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    color: var(--gray-400);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  @media (min-width: 760px) {
    .timeline__nav { gap: 1rem; }
    .timeline__years li { flex-basis: 7rem; }
    .timeline__panel {
      grid-template-columns: minmax(8rem, 0.32fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 4.5rem);
    }
  }
</style>
