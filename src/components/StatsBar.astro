---
import { stats } from '../config';
---

<section class="stats">
  <div class="container stats__inner">
    {stats.map((s, i) => (
      <div class="stats__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
        <span class="stats__value">{s.value}</span>
        <span class="stats__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats { background: var(--teal-900); color: var(--white); }
  /* Los separadores van en los ítems, no como fondo detrás de un gap de 1px:
     .stats__inner es también el .container, así que ese fondo asomaba por sus
     48px de padding-inline y dejaba dos franjas claras de 49px en los extremos. */
  .stats__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  .stats__item {
    padding: clamp(1.5rem, 3vw, 2.25rem) 1rem;
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    text-align: center;
    border-left: 1px solid rgb(255 255 255 / 0.12);
  }
  /* Con cinco ítems en dos columnas el último quedaba huérfano a media fila. */
  .stats__item:nth-child(2n + 1) { border-left: 0; }
  .stats__item:last-child { grid-column: 1 / -1; }
  .stats__value {
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--lime-500);
    line-height: 1;
  }
  .stats__label {
    font-size: var(--text-kicker);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.66);
    font-weight: 600;
  }
  @media (min-width: 760px) {
    .stats__inner { grid-template-columns: repeat(5, 1fr); }
    .stats__item:nth-child(2n + 1) { border-left: 1px solid rgb(255 255 255 / 0.12); }
    .stats__item:first-child { border-left: 0; }
    .stats__item:last-child { grid-column: auto; }
  }
</style>
