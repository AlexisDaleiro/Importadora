---
import { getCollection } from 'astro:content';
import BrandCard from './BrandCard.astro';
import Button from './Button.astro';

// El sitio oficial no publica logotipos de marca en formato reutilizable, así que
// las tarjetas son tipográficas hasta que Districo entregue los archivos.
const products = await getCollection('products');

const brands = (await getCollection('brands'))
  .map((b) => ({
    ...b,
    count: products.filter((p) => p.data.brand?.id === b.id).length,
    lineas: b.data.categories.map((c) => c.id),
  }))
  .sort((a, b) => b.count - a.count || a.data.name.localeCompare(b.data.name));
---

<section class="brands section">
  <div class="container">
    <header class="brands__head" data-reveal>
      <div>
        <span class="kicker kicker--accent">Representaciones</span>
        <h2 class="title-lg">Las {brands.length} marcas que distribuimos</h2>
      </div>
      <p class="lead">
        Alimento balanceado, arenas sanitarias, cuidado animal y snacks de fábricas de la región,
        con stock permanente en la Casa Matriz.
      </p>
    </header>

    <ul class="brands__grid">
      {brands.map((brand, i) => (
        <li data-reveal style={`--reveal-delay:${Math.min(i, 8) * 45}ms`}>
          <BrandCard
            id={brand.id}
            name={brand.data.name}
            linea={brand.lineas[0] ?? ''}
            count={brand.count}
          />
        </li>
      ))}
    </ul>

    <div class="actions brands__cta" data-reveal>
      <Button href="/productos" variant="primary" size="lg">Ver el catálogo completo</Button>
    </div>
  </div>
</section>

<style>
  .brands { background: var(--white); }
  .brands__head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .brands__head .kicker { display: block; margin-bottom: 0.5rem; }

  .brands__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(158px, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }
  .brands__grid > li { display: grid; }
  .brands__cta { margin-top: clamp(2rem, 4vw, 3rem); }

  @media (min-width: 940px) {
    .brands__head { grid-template-columns: 1fr 1fr; align-items: end; gap: 3rem; }
  }
</style>
