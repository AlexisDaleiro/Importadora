---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import heroImg from '../assets/institutional/casa-matriz-fachada.jpg';
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text" data-reveal>
      <span class="kicker">Distribución en todo Uruguay</span>
      <h1 class="title-hero">Alimento y cuidado para mascotas, <em>de punta a punta</em> del país.</h1>
      <p class="lead">
        Desde 1995 distribuimos alimento balanceado, arenas sanitarias, cuidado animal y snacks
        a veterinarias, pet shops y grandes superficies de todo Uruguay.
      </p>
      <div class="actions">
        <Button href="/productos" variant="primary" size="lg">Ver catálogo</Button>
        <Button href="/contacto" variant="outline" size="lg">Hablar con ventas</Button>
      </div>
    </div>

    <div class="hero__media" data-reveal style="--reveal-delay:120ms">
      <span class="blob hero__blob" aria-hidden="true"></span>
      <Image
        src={heroImg}
        alt="Fachada de la Casa Matriz de Districo S.A. en Montevideo"
        widths={[520, 780, 1100]}
        sizes="(min-width: 940px) 46vw, 92vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__sticker">
        <span>ISO</span>
        <strong>9001</strong>
        <span>desde 2019</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
    /* El degradado se mudó a .portada (src/pages/index.astro): corre continuo
       desde abajo del header hasta donde arrancan las estadísticas, y es lo
       que borra la costura entre el banner y el hero. */
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__text > * + * { margin-top: 1.5rem; }
  .hero__text h1 { max-width: 15ch; }
  .hero__text .kicker { margin-bottom: 0.25rem; }
  .hero h1 em { font-style: normal; color: var(--teal-600); }
  .hero .actions { padding-top: 0.5rem; }

  .hero__media { position: relative; }
  .hero__blob {
    width: 78%;
    aspect-ratio: 1;
    background: var(--lime-500);
    top: -8%;
    right: -6%;
    opacity: 0.9;
  }
  .hero__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .hero__sticker {
    position: absolute;
    z-index: 2;
    left: -0.5rem;
    bottom: -1.25rem;
    width: 118px;
    height: 118px;
    border-radius: 50%;
    background: var(--teal-900);
    color: var(--white);
    display: grid;
    place-content: center;
    text-align: center;
    line-height: 1.15;
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: var(--shadow-md);
    rotate: -8deg;
  }
  .hero__sticker strong { font-size: 1.6rem; letter-spacing: -0.02em; color: var(--lime-500); }

  /* ── Presupuesto vertical de la portada ───────────────────────────────
     Desde 940px el hero es la fila elastica de .portada (index.astro): el
     banner pide su alto y el hero se queda con todo el resto de la primera
     pantalla. Por eso acá no hay ninguna altura declarada, solo la escala del
     contenido, que mezcla vw y vh para responder tambien al alto del viewport.
     En una pantalla muy baja el contenido se pasa de largo y hay scroll, nunca
     recorte.
     Mobile queda fuera a proposito: alli el bloque se apila y el objetivo no
     aplica, asi que ninguna de estas reglas sale de la media query. */
  @media (min-width: 940px) {
    .hero {
      /* Alto de la foto. De aca sale tambien su ancho, via la relacion 4:3,
         y con el ancho se achican en proporcion el circulo lima y el badge. */
      --hero-media-h: clamp(215px, 25vh + 8vw, 460px);
      /* El hero ocupa toda la fila que le deja el banner y centra su contenido
         ahi adentro: es lo que lo deja respirar sin atarlo a un alto fijo. */
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: clamp(1rem, 2.4vh, 3rem);
    }
    .hero__inner {
      /* La columna de la foto mide lo que mide la foto; el resto es para el
         texto, que igual se detiene en su propio max-width. */
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(1.75rem, 3vw, 3rem);
    }
    .hero__text > * + * { margin-top: clamp(0.7rem, 1.6vh, 1.75rem); }
    /* Sigue siendo el texto mas grande de la pagina, con el mismo peso 800.
       El max-width de 19ch es lo que mantiene el titular en tres lineas: con
       15ch eran cinco y se comia la pantalla entera. La escala subio con el
       espacio que dejo libre la barra de stats al salir del presupuesto. */
    .hero__text h1 {
      font-size: clamp(2.1rem, 0.7rem + 2vw + 1.9vh, 4.4rem);
      max-width: 19ch;
    }
    .hero__text .lead { font-size: var(--text-lg); max-width: 46ch; }
    .hero .actions { padding-top: clamp(0.25rem, 0.9vh, 0.75rem); }

    .hero__media { width: calc(var(--hero-media-h) * 4 / 3); }
    .hero__blob { width: 68%; }
    /* En porcentaje del ancho de la foto, para que no se coma la imagen
       cuando la foto se achica. El piso de 80px deja las etiquetas en 12px
       sin que se toquen. */
    .hero__sticker {
      width: clamp(80px, 24%, 118px);
      height: auto;
      aspect-ratio: 1;
      bottom: -1rem;
    }
    .hero__sticker strong { font-size: clamp(1.05rem, 0.55rem + 1vw, 1.6rem); }
  }
</style>
