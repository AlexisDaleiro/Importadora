---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

/*
  Carrusel de novedades del home. Vive entre el header y el hero.

  Tres modos según cuántos banners activos haya, resueltos acá y no en la
  página: con 0 no se renderiza nada, con 1 se pinta un banner fijo (sin
  puntos, sin flechas y sin slides asomados, que con uno solo se ven rotos) y
  con 2 o más se arma el carrusel.

  El movimiento es el scroll nativo del track con scroll-snap. No hay librería
  ni animación propia: el JS solo lee en qué slide quedó el scroll para pintar
  los puntos, y lo empuja cuando alguien toca un punto, una flecha o un slide
  asomado.
*/
const slides = (await getCollection('banners'))
  .filter((b) => b.data.active)
  .sort((a, b) => a.data.order - b.data.order);

const carrusel = slides.length >= 2;
---

{slides.length > 0 && (
  <section
    class:list={['bnr', { 'bnr--solo': !carrusel }]}
    aria-label="Novedades de Districo"
    aria-roledescription={carrusel ? 'carrusel' : undefined}
  >
    <div class="container">
      <div class="bnr__stage">
        <div class="bnr__track" id="bnr-track" tabindex={carrusel ? 0 : undefined}>
          {slides.map((s, i) => (
            <a
              class="bnr__slide"
              href={s.data.href}
              style={`--acc:${s.data.accent}`}
              tabindex={carrusel && i > 0 ? -1 : undefined}
            >
              <Image
                src={s.data.image}
                alt={s.data.alt}
                width={1240}
                height={330}
                widths={[600, 900, 1160, 2320]}
                sizes="(min-width: 940px) 1160px, 92vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="bnr__img"
              />
              <span class="bnr__scrim" aria-hidden="true"></span>
              <span class="bnr__text">
                <span class="kicker kicker--onDark">{s.data.kicker}</span>
                <span class="bnr__titulo">{s.data.title}</span>
                <span class="bnr__cta">{s.data.cta}</span>
              </span>
            </a>
          ))}
        </div>

        {carrusel && (
          <>
            <button class="bnr__flecha bnr__flecha--prev" type="button" data-bnr-paso="-1" aria-label="Banner anterior">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button class="bnr__flecha bnr__flecha--next" type="button" data-bnr-paso="1" aria-label="Banner siguiente">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </>
        )}
      </div>

      {carrusel && (
        <div class="bnr__puntos" role="group" aria-label="Elegir banner">
          {slides.map((_, i) => (
            <button
              class="bnr__punto"
              type="button"
              data-bnr-ir={i}
              aria-label={`Ir al slide ${i + 1} de ${slides.length}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span aria-hidden="true"></span>
            </button>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<script>
  // Intervalo del avance automatico. Es la unica perilla del autoplay: de aca
  // sale tanto el temporizador como la duracion del relleno de los puntos,
  // que viaja al CSS como --bnr-auto. Probado entre 4000 y 5000 ms.
  const AUTOPLAY_MS = 4500;

  // Con el ClientRouter el modulo se evalua una sola vez por sesion, asi que
  // el listener corre tambien en paginas donde el carrusel no existe, y cada
  // vuelta al home montaria un temporizador y un juego de listeners sobre los
  // de la visita anterior: el banner empezaria a rotar cada vez mas rapido.
  // Toda instancia guarda como desarmarse y se desarma antes de la siguiente.
  let desmontar: (() => void) | null = null;
  const limpiar = () => { desmontar?.(); desmontar = null; };
  document.addEventListener('astro:before-swap', limpiar);

  document.addEventListener('astro:page-load', () => {
    limpiar();

    const track = document.getElementById('bnr-track');
    if (!track) return;
    const seccion = track.closest<HTMLElement>('.bnr');
    if (!seccion) return;

    const reales = [...track.querySelectorAll<HTMLAnchorElement>('.bnr__slide')];
    if (reales.length < 2) return; // banner fijo: no hay nada que manejar

    const puntos = [...seccion.querySelectorAll<HTMLButtonElement>('[data-bnr-ir]')];
    const N = reales.length;

    // Un solo AbortController para todos los listeners de esta instancia: el
    // desmontaje es un abort y no una lista de removeEventListener que se
    // desincroniza en cuanto se agrega un listener mas.
    const ac = new AbortController();
    const on = { signal: ac.signal };
    seccion.style.setProperty('--bnr-auto', `${AUTOPLAY_MS}ms`);

    // ── Cinta infinita ───────────────────────────────────────────────────
    // El track es scroll nativo, asi que los slides estan fisicamente en
    // fila y el primero no tiene nada a su izquierda: pasar del ultimo al
    // primero seria un rebobinado. Se clona el ultimo al principio y el
    // primero al final, siempre dos clones sea cual sea la cantidad de
    // banners, calculados desde la coleccion y nunca escritos a mano. La
    // fila queda [N] [1] [2] ... [N] [1]: el usuario nunca ve un extremo,
    // siempre asoma un vecino de los dos lados, y al aterrizar sobre un clon
    // se reposiciona al gemelo real de golpe, invisible porque lo pintado es
    // identico.
    const clonar = (s: HTMLAnchorElement) => {
      const c = s.cloneNode(true) as HTMLAnchorElement;
      c.setAttribute('aria-hidden', 'true');
      c.tabIndex = -1;
      return c;
    };
    track.prepend(clonar(reales[N - 1]));
    track.append(clonar(reales[0]));

    // Posicion fisica (0 .. N+1) contra indice logico (0 .. N-1), que es el
    // que ven los puntos y el aria de los slides.
    const fisicos = [...track.querySelectorAll<HTMLAnchorElement>('.bnr__slide')];
    fisicos.forEach((s, j) => { s.dataset.p = String(j); });
    const logico = (p: number) => (((p - 1) % N) + N) % N;

    let pos = 1;      // arranca en el primer slide real, no en el clon
    let activo = 0;   // indice logico pintado

    // Distancia entre dos slides, gap incluido. Se lee del DOM en vez de
    // recalcularla con los tokens: asi sigue valiendo en los dos breakpoints
    // y despues de cualquier cambio de CSS.
    const paso = () => fisicos[1].offsetLeft - fisicos[0].offsetLeft;

    function pintar(p: number) {
      pos = p;
      activo = logico(p);
      fisicos.forEach((s, j) => {
        s.classList.toggle('is-on', j === p);
        // Los slides que no estan a la vista salen del recorrido del
        // tabulador, y los clones no entran nunca.
        if (j === p && j > 0 && j <= N) s.removeAttribute('tabindex');
        else s.tabIndex = -1;
      });
      puntos.forEach((b, j) => {
        if (j === activo) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
    }

    // Reposicionamiento invisible sobre el gemelo real. No hace falta
    // silenciar al vigia del scroll: pintar() deja 'pos' en el destino antes
    // de que llegue el evento, asi que el vigia se encuentra ya sincronizado
    // y se va por su propia guarda.
    const teletransportar = (p: number) => {
      track.scrollTo({ left: p * paso(), behavior: 'instant' });
      pintar(p);
    };

    // Todo movimiento pasa por aca y siempre es suave: un paso cae en la
    // posicion vecina (clon incluido) y un clic en un punto cruza los slides
    // que haga falta. behavior 'auto' respeta el scroll-behavior del CSS,
    // que bajo prefers-reduced-motion pasa a instantaneo por token.
    const irPos = (p: number) => {
      track.scrollTo({ left: p * paso(), behavior: 'auto' });
      pintar(p);
      // Navegar a mano no apaga el autoplay: reinicia la cuenta desde aca, asi
      // un toque accidental no lo deja detenido para siempre.
      arrancar();
    };
    // El indice da la vuelta en los dos sentidos: es lo que hace infinito
    // tanto al autoplay como a las flechas. Cuando el paso se saldria de los
    // slides reales, primero nos paramos de golpe en el clon del extremo
    // opuesto —invisible, porque pinta lo mismo que el slide donde estabamos—
    // y recien desde ahi corre el paso suave. Asi el banner entra por el
    // borde que corresponde en vez de rebobinar, y el salto nunca cae en
    // medio de una animacion.
    const avanzar = (d: number) => {
      if (pos + d > N) teletransportar(0);
      else if (pos + d < 1) teletransportar(N + 1);
      irPos(pos + d);
    };
    const irA = (n: number) => irPos((((n % N) + N) % N) + 1);

    // Red de seguridad del deslizamiento tactil, que es el unico camino que
    // puede dejar el track en reposo sobre un clon. Fin de scroll sin
    // depender de 'scrollend', que Safari solo trae desde 18.2: si no llego
    // un scroll nuevo en 140ms, el track quedo quieto.
    let reposo = 0;
    const alQuedarQuieto = () => {
      if (pos === 0) teletransportar(N);
      else if (pos === N + 1) teletransportar(1);
    };

    // ── Avance automatico ────────────────────────────────────────────────
    // Un temporizador y un conjunto de motivos de pausa: mientras haya al
    // menos un motivo el intervalo no corre. Van por nombre para que dos
    // causas simultaneas (mouse encima y pestana en segundo plano) no se
    // pisen entre si al soltarse una sola.
    const mq = matchMedia('(prefers-reduced-motion: reduce)');
    const motivos = new Set<string>();
    let timer = 0;

    const detener = () => { clearInterval(timer); timer = 0; };
    function arrancar() {
      detener();
      if (mq.matches || motivos.size > 0) return;
      timer = window.setInterval(() => avanzar(1), AUTOPLAY_MS);
    }
    const sincronizar = () => {
      // .bnr--auto enciende el relleno de los puntos. Sin autoplay el punto
      // activo vuelve a ser una pildora llena y quieta.
      seccion.classList.toggle('bnr--auto', !mq.matches);
      seccion.classList.toggle('bnr--pausa', motivos.size > 0);
      arrancar();
    };
    const pausar = (m: string) => { motivos.add(m); sincronizar(); };
    const seguir = (m: string) => { motivos.delete(m); sincronizar(); };

    // Deslizar en mobile tambien es navegar a mano, asi que reinicia la
    // cuenta. El scroll que dispara el propio autoplay no entra: pintar() ya
    // movio 'activo' antes de que el scroll suave termine.
    track.addEventListener('scroll', () => {
      clearTimeout(reposo);
      reposo = window.setTimeout(alQuedarQuieto, 140);
      const d = paso();
      if (d <= 0) return;
      const p = Math.round(track.scrollLeft / d);
      if (p === pos) return;
      pintar(p);
      arrancar();
    }, on);

    seccion.addEventListener('mouseenter', () => pausar('mouse'), on);
    seccion.addEventListener('mouseleave', () => seguir('mouse'), on);
    // Alguien navegando con Tab no puede perseguir un slide que se mueve.
    seccion.addEventListener('focusin', () => pausar('foco'), on);
    seccion.addEventListener('focusout', () => seguir('foco'), on);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pausar('pestana'); else seguir('pestana');
    }, on);
    // El usuario puede cambiar la preferencia con la pagina abierta.
    mq.addEventListener('change', sincronizar, on);

    // Fuera de pantalla no hay nada que mirar: el intervalo se suelta.
    const io = new IntersectionObserver(
      ([e]) => (e.isIntersecting ? seguir('fuera') : pausar('fuera')),
      { threshold: 0.35 },
    );
    io.observe(seccion);

    desmontar = () => { detener(); clearTimeout(reposo); io.disconnect(); ac.abort(); };

    for (const b of puntos) b.addEventListener('click', () => irA(Number(b.dataset.bnrIr)), on);
    for (const f of seccion.querySelectorAll<HTMLButtonElement>('[data-bnr-paso]')) {
      f.addEventListener('click', () => avanzar(Number(f.dataset.bnrPaso)), on);
    }

    // Un clic en un slide asomado lo centra en vez de navegar: el enlace solo
    // dispara cuando el slide ya es el activo. Se centra por posicion fisica,
    // asi un clic sobre un clon va al clon y desde ahi se reacomoda solo.
    for (const s of fisicos) {
      s.addEventListener('click', (e) => {
        const p = Number(s.dataset.p);
        if (p !== pos) { e.preventDefault(); irPos(p); }
      }, on);
    }

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); avanzar(1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); avanzar(-1); }
    }, on);

    // El primer slide real es el segundo de la fila: hay que correrse antes
    // de que se vea el clon de la izquierda.
    teletransportar(1);
    sincronizar();
  });
</script>

<style>
  .bnr {
    /* Asomo del slide vecino a cada lado y aire entre slides. El padding del
       track es la suma de los dos: con eso el slide activo queda centrado y
       del vecino se ve exactamente --peek. */
    --peek: 16px;
    --gap: 10px;
    --ar: 4 / 3;
    padding-block: 1rem 0;
  }
  .bnr__stage { position: relative; }

  .bnr__track {
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    padding-inline: calc(var(--peek) + var(--gap));
    scroll-snap-type: x mandatory;
    /* El token pasa a 'auto' bajo prefers-reduced-motion: el cambio de slide
       es instantaneo y lo unico que queda es el cross-fade de los vecinos. */
    scroll-behavior: var(--scroll-carousel);
    scrollbar-width: none;
  }
  .bnr__track::-webkit-scrollbar { display: none; }
  /* Sin puntos ni asomo cuando hay un solo banner. */
  .bnr--solo .bnr__track { padding-inline: 0; overflow-x: visible; }

  .bnr__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: center;
    /* La altura queda reservada desde el primer frame: el banner esta arriba
       de todo y cualquier salto se lo come el LCP. */
    aspect-ratio: var(--ar);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--acc);
    /* Familia SEGURA: los vecinos se atenuan con opacidad, que se conserva
       igual bajo reduce. */
    opacity: 0.55;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .bnr__slide.is-on,
  .bnr--solo .bnr__slide { opacity: 1; }

  .bnr__img { width: 100%; height: 100%; object-fit: cover; }

  .bnr__scrim {
    position: absolute;
    inset: 0;
    /* Zona segura de contraste: el texto se apoya siempre sobre el color de
       acento casi opaco, nunca sobre la foto pelada.
       En mobile el slide mide 283px de ancho y no hay lugar para una franja
       lateral, asi que el velo es horizontal: la foto se ve arriba y el texto
       va abajo, sobre la parte opaca. */
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--acc) 25%, transparent) 22%,
      color-mix(in srgb, var(--acc) 92%, transparent) 36%,
      color-mix(in srgb, var(--acc) 92%, transparent) 100%
    );
  }

  .bnr__text {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: end;
    gap: 0.5rem;
    width: min(100%, 26rem);
    padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem);
    color: var(--white);
  }
  .bnr__titulo {
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .bnr__cta {
    margin-top: 0.35rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-pill);
    background: var(--lime-500);
    color: var(--teal-950);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: background-color var(--dur-fast) ease;
  }
  .bnr__slide:hover .bnr__cta { background: var(--lime-400); }

  /* Puntos: debajo del banner, sobre el fondo de la pagina. El area tactil
     mide 44px aunque la pildora se vea chica. */
  .bnr__puntos {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    padding-top: 0.15rem;
  }
  .bnr__punto {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .bnr__punto > span {
    position: relative;
    display: block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--gray-400);
    overflow: hidden;
    /* El activo se distingue por forma ademas de por color: se estira a
       pildora, asi no depende de percibir la diferencia de tono. */
    transition: width var(--dur-fast) var(--ease-out), background-color var(--dur-fast) ease;
  }
  .bnr__punto[aria-current] > span { width: 26px; background: var(--teal-800); }

  /* Progreso del intervalo. Solo existe con el autoplay encendido: es lo que
     avisa que el slide va a cambiar solo. La pildora activa pasa a ser el
     canal gris y este relleno la recorre en --bnr-auto, que lo escribe el JS
     desde AUTOPLAY_MS para no tener el intervalo definido en dos lugares.
     Se rearma sola en cada slide porque solo aplica al punto con
     aria-current, y ese atributo se mueve en cada paso. */
  .bnr--auto .bnr__punto[aria-current] > span { background: var(--gray-300); }
  .bnr__punto > span::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--teal-800);
    transform-origin: left center;
    scale: 0 1;
  }
  .bnr--auto .bnr__punto[aria-current] > span::after {
    animation: bnr-relleno var(--bnr-auto, 4500ms) linear forwards;
  }
  .bnr--auto.bnr--pausa .bnr__punto[aria-current] > span::after {
    animation-play-state: paused;
  }
  @keyframes bnr-relleno {
    from { scale: 0 1; }
    to { scale: 1 1; }
  }

  /* Flechas: solo desktop, superpuestas sobre el slide activo. */
  .bnr__flecha { display: none; }

  @media (min-width: 940px) {
    .bnr {
      --peek: 24px;
      --gap: 16px;
      --scrim-end: 62%;
      /* El aire de arriba lo pone .portada en index.astro, que es quien
         reparte la primera pantalla. Acá queda en cero para que no haya
         costura entre el header y el banner. */
      padding-block: 0;
    }
    /* Desde 940px el alto del banner deja de salir de una relacion de aspecto
       fija (era 6:1, o sea 206px en 1366 de ancho para cualquier alto de
       pantalla) y pasa a mezclar vw con vh: header + banner + hero tienen que
       llenar la primera pantalla sin pasarse, y con el alto atado solo al
       ancho el banner se comia el presupuesto en un portatil. La foto absorbe
       el cambio con object-fit: cover.
       Con la barra de stats fuera del presupuesto el banner subio de
       clamp(120px, 9vh + 6vw, 210px) a esta escala: es el reparto del espacio
       que se libero, no un agrandamiento suelto. */
    .bnr__slide {
      aspect-ratio: auto;
      height: clamp(150px, 13vh + 5vw, 300px);
    }
    /* --text-2xl deja el bloque de texto midiendo exactamente el alto del
       slide: un titulo de una palabra mas se cortaria. */
    /* Desktop: el slide es una franja 6:1 y el velo pasa a ser vertical, con
       la mitad derecha libre para la foto. */
    .bnr__scrim {
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--acc) 92%, transparent) 0%,
        color-mix(in srgb, var(--acc) 92%, transparent) var(--scrim-end) ,
        transparent 100%
      );
    }
    .bnr__text { justify-content: center; padding-block: 0.9rem; }
    .bnr__titulo { font-size: var(--text-xl); }
    /* El bloque de texto no puede pasar de --scrim-end: mas alla el velo se
       abre y el blanco quedaria sobre la foto pelada. El padding de la
       izquierda deja libre la flecha. */
    .bnr__text { width: min(58%, 34rem); padding-inline-start: 6rem; }

    .bnr__flecha {
      position: absolute;
      top: 50%;
      translate: 0 -50%;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 50%;
      background: rgb(255 255 255 / 0.9);
      color: var(--teal-950);
      cursor: pointer;
      transition: background-color var(--dur-fast) ease;
    }
    .bnr__flecha:hover { background: var(--white); }
    .bnr__flecha--prev { inset-inline-start: calc(var(--peek) + var(--gap) + 0.5rem); }
    .bnr__flecha--next { inset-inline-end: calc(var(--peek) + var(--gap) + 0.5rem); }
    .bnr--solo .bnr__flecha { display: none; }
  }
</style>
