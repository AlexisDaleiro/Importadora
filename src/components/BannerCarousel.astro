---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';

/*
  Carrusel de novedades del home. Vive entre el header y el hero.

  Tres modos según cuántos banners activos haya, resueltos acá y no en la
  página: con 0 no se renderiza nada, con 1 se pinta un banner fijo (sin
  puntos y sin flechas) y con 2 o más se arma el carrusel. La cantidad sale
  siempre de la colección: no hay ningún número de banners escrito a mano.

  El movimiento es el scroll nativo del track con scroll-snap. No hay librería
  ni animación propia: el JS solo lee en qué slide quedó el scroll para pintar
  los puntos, y lo empuja cuando alguien toca un punto o una flecha.

  El track no lleva padding lateral, así que el slide activo ocupa la ventana
  entera y los vecinos quedan afuera del borde de recorte: no se ve nunca un
  fragmento de otro banner.
*/
const activos = (await getCollection('banners'))
  .filter((b) => b.data.active)
  .sort((a, b) => a.data.order - b.data.order);

// Los PNG y JPG oficiales quedan como fuente en el repo; al navegador se le
// sirve WebP generado por astro:assets. Las dos piezas se resuelven acá y no
// en el markup porque getImage es asincrónico.
const slides = await Promise.all(
  activos.map(async (b) => ({
    data: b.data,
    desktop: await getImage({ src: b.data.imageDesktop, widths: [1160, 1560, 1950], format: 'webp' }),
    mobile: await getImage({ src: b.data.imageMobile, widths: [390, 560, 768, 1024], format: 'webp' }),
  })),
);

const carrusel = slides.length >= 2;
---

{slides.length > 0 && (
  <section
    class="bnr"
    aria-label="Novedades de Districo"
    aria-roledescription={carrusel ? 'carrusel' : undefined}
  >
    <div class="container">
      <div class="bnr__stage">
        <div class="bnr__track" id="bnr-track" tabindex={carrusel ? 0 : undefined}>
          {slides.map((s, i) => (
            <a class="bnr__slide" href={s.data.href} aria-label={s.data.alt}>
              {/* El enlace envuelve la pieza entera: no hay texto propio que
                  pueda recibir el clic por su cuenta. La vertical y la
                  apaisada son artes distintos, no dos recortes de la misma
                  foto, asi que van como dos fuentes y no como un srcset. */}
              <picture>
                <source media="(min-width: 768px)" srcset={s.desktop.srcSet.attribute} sizes="(min-width: 940px) 1344px, 100vw" />
                <img
                  class="bnr__img"
                  src={s.mobile.src}
                  srcset={s.mobile.srcSet.attribute}
                  sizes="100vw"
                  width={768}
                  height={1024}
                  alt=""
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </picture>
            </a>
          ))}
        </div>

        {carrusel && (
          <>
            <button class="bnr__flecha bnr__flecha--prev" type="button" data-bnr-paso="-1" aria-label="Banner anterior">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button class="bnr__flecha bnr__flecha--next" type="button" data-bnr-paso="1" aria-label="Banner siguiente">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </>
        )}
      </div>

      {carrusel && (
        <div class="bnr__puntos" role="group" aria-label="Elegir banner">
          {slides.map((_, i) => (
            <button
              class="bnr__punto"
              type="button"
              data-bnr-ir={i}
              aria-label={`Ir al slide ${i + 1} de ${slides.length}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span aria-hidden="true"></span>
            </button>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<script>
  // Solo puntos y flechas. El desplazamiento es el scroll nativo del track con
  // scroll-snap, y los anchos salen del CSS: acá no se calcula ni se escribe
  // ningún estilo de layout. Sin autoplay, sin temporizadores y sin
  // ResizeObserver. Si este script no corre, el carrusel se sigue deslizando
  // con el dedo y muestra el primer banner.
  //
  // Todo va dentro de un try/catch: un fallo acá no puede cortar la ejecución
  // de los scripts de los otros componentes.
  let desmontar: (() => void) | null = null;
  const limpiar = () => { desmontar?.(); desmontar = null; };
  document.addEventListener('astro:before-swap', limpiar);

  document.addEventListener('astro:page-load', () => {
    try {
      limpiar();

      const track = document.getElementById('bnr-track');
      const seccion = track?.closest<HTMLElement>('.bnr');
      if (!track || !seccion) return;

      const slides = [...track.querySelectorAll<HTMLAnchorElement>('.bnr__slide')];
      const puntos = [...seccion.querySelectorAll<HTMLButtonElement>('[data-bnr-ir]')];
      if (slides.length < 2 || puntos.length === 0) return; // banner fijo

      const ac = new AbortController();
      const on = { signal: ac.signal };
      desmontar = () => ac.abort();

      // Lectura, no cálculo: la distancia entre dos slides la fija el CSS y
      // acá solo se consulta para saber adónde desplazar el scroll.
      const paso = () => slides[1].offsetLeft - slides[0].offsetLeft;
      const actual = () => {
        const d = paso();
        return d > 0 ? Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / d))) : 0;
      };

      const pintar = () => {
        const i = actual();
        puntos.forEach((b, j) => {
          if (j === i) b.setAttribute('aria-current', 'true');
          else b.removeAttribute('aria-current');
        });
      };

      const irA = (i: number) => {
        const destino = Math.min(slides.length - 1, Math.max(0, i));
        track.scrollTo({ left: destino * paso(), behavior: 'smooth' });
      };

      track.addEventListener('scroll', pintar, { ...on, passive: true });
      for (const b of puntos) b.addEventListener('click', () => irA(Number(b.dataset.bnrIr)), on);
      for (const f of seccion.querySelectorAll<HTMLButtonElement>('[data-bnr-paso]')) {
        f.addEventListener('click', () => irA(actual() + Number(f.dataset.bnrPaso)), on);
      }
      track.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        irA(actual() + (e.key === 'ArrowRight' ? 1 : -1));
      }, on);

      pintar();
    } catch (error) {
      console.error('[BannerCarousel]', error);
    }
  });
</script>

<style>
  .bnr {
    /* Aire entre slides. Es la separación durante el desplazamiento, no un
       asomo: el track no lleva padding, así que el slide activo ocupa el ancho
       entero de la ventana y el vecino queda justo afuera del borde de
       recorte. Nunca se ve un fragmento de otro banner. */
    --gap: 10px;
    /* La relacion de aspecto es la de la pieza oficial, 768x1024 en la
       vertical y 1950x500 en la apaisada, para que el arte entre entero:
       estos banners traen su texto incrustado y cualquier recorte se lo come. */
    --ar: 768 / 1024;
    padding-block: 1rem 0;
  }
  .bnr__stage { position: relative; }

  .bnr__track {
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .bnr__track::-webkit-scrollbar { display: none; }

  .bnr__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: center;
    /* La altura queda reservada desde el primer frame: el banner esta arriba
       de todo y cualquier salto se lo come el LCP. */
    aspect-ratio: var(--ar);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--gray-100);
  }

  /* contain y no cover: la relacion del slide ya es la de la pieza, asi que
     no hay nada que recortar, y si alguna vez entra un arte con otra
     relacion se ve entero con franjas en vez de perder texto. */
  .bnr__img { width: 100%; height: 100%; object-fit: contain; }


  /* Puntos: debajo del banner, sobre el fondo de la pagina. El area tactil
     mide 44px aunque la pildora se vea chica. */
  .bnr__puntos {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    padding-top: 0.15rem;
  }
  .bnr__punto {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .bnr__punto > span {
    position: relative;
    display: block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--gray-400);
    overflow: hidden;
    /* El activo se distingue por forma ademas de por color: se estira a
       pildora, asi no depende de percibir la diferencia de tono. */
    transition: width var(--dur-fast) var(--ease-out), background-color var(--dur-fast) ease;
  }
  .bnr__punto[aria-current] > span { width: 26px; background: var(--teal-800); }
  /* El punto inactivo no daba ninguna señal de ser pulsable. Se alarga a mitad
     de camino del activo, así el gesto se lee antes del clic. */
  .bnr__punto:hover:not([aria-current]) > span,
  .bnr__punto:focus-visible:not([aria-current]) > span { width: 16px; background: var(--teal-600); }

  /* Flechas: solo desktop, superpuestas sobre el slide activo. */
  .bnr__flecha { display: none; }

  /* El cambio de pieza va en 768px, el ancho para el que esta dibujada la
     vertical, y NO en los 940px del resto del componente. Con el corte en 940
     una tablet de 834px recibia el arte de telefono estirado: 700px de ancho
     por 934 de alto, mas que la pantalla entera. Este breakpoint tiene que
     coincidir con el `media` del <source> en el markup. */
  @media (min-width: 768px) {
    /* La pieza apaisada, 1950x500. El alto sale del ancho y no de una escala
       propia: estos banners traen el texto incrustado, asi que cualquier
       recorte o deformacion corta palabras. */
    .bnr { --ar: 1950 / 500; }
  }

  @media (min-width: 940px) {
    .bnr {
      --gap: 16px;
      /* El aire de arriba lo pone .portada en index.astro, que es quien
         reparte la primera pantalla. Acá queda en cero para que no haya
         costura entre el header y el banner. */
      padding-block: 0;
    }
    /* Con el alto atado al ancho, en un portátil de 720px de alto la franja
       1950x500 se comía el presupuesto del hero y empujaba la barra de
       estadísticas 101px abajo del pliegue. La salida no es recortar el arte,
       que tiene el texto incrustado, sino achicar el banner entero: se le pone
       techo al alto y el ancho lo sigue por la relación de aspecto. En una
       pantalla alta el techo no llega a tocar y el banner va a ancho completo. */
    .bnr__stage {
      /* Los 344px son el alto que le toca al banner cuando ocupa el ancho
         entero del container (1440px menos dos gutters de 48px) con la
         relación 1950x500. El 36vh es el que manda en pantallas bajas: ahí el
         banner se angosta en vez de robarle el alto al hero. En 1920x1080 gana
         el tope en píxeles y el banner va a ancho completo. */
      --bnr-alto-max: min(344px, 36vh);
      max-width: calc(var(--bnr-alto-max) * 1950 / 500);
      margin-inline: auto;
    }

    .bnr__flecha {
      position: absolute;
      top: 50%;
      translate: 0 -50%;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 50%;
      background: rgb(255 255 255 / 0.9);
      color: var(--teal-950);
      cursor: pointer;
      /* El translate del centrado vertical ya ocupa `translate`, así que el
         crecimiento va por `scale`, que es una propiedad aparte. */
      transition: background-color var(--dur-fast) ease, scale var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) ease;
    }
    .bnr__flecha:hover { background: var(--white); }
    .bnr__flecha:active { scale: 0.96; box-shadow: none; }
    /* Sin asomo, el borde del slide es el borde del stage: las flechas se
       apoyan directamente sobre el arte. */
    .bnr__flecha--prev { inset-inline-start: 0.75rem; }
    .bnr__flecha--next { inset-inline-end: 0.75rem; }
  }

  /* Una tablet apaisada o un portátil táctil entran en los 940px de arriba,
     y ahí el :hover queda pegado después del toque: la flecha se quedaría
     agrandada. El crecimiento pide puntero; el cambio de fondo no molesta y
     queda en el bloque de arriba. */
  @media (min-width: 940px) and (hover: hover) {
    .bnr__flecha:hover { scale: 1.1; box-shadow: var(--shadow-md); }
  }
</style>
