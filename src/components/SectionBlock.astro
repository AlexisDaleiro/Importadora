---
// Bloque de sección full-bleed con color de fondo opcional.
interface Props {
  bg?: string;
  color?: string;
  full?: boolean;
  id?: string;
  class?: string;
}
const { bg, color, full = false, id, class: className = '' } = Astro.props;
const style = [bg && `background:${bg}`, color && `color:${color}`].filter(Boolean).join(';');
---

<section id={id} class={`block ${full ? 'block--full' : ''} ${className}`} style={style || undefined}>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .block { padding-block: var(--section-y); position: relative; }
  .block--full { width: 100%; }
</style>
