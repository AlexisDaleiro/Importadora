---
import { Image } from 'astro:assets';
import logo from '../assets/brand/districo-logo.png';

interface Props { onDark?: boolean; class?: string; }
const { onDark = false, class: className = '' } = Astro.props;
---

<Image
  src={logo}
  alt="Districo S.A."
  widths={[160, 320]}
  sizes="150px"
  loading="eager"
  class={`logo ${onDark ? 'logo--onDark' : ''} ${className}`}
/>

<style>
  /* Logo oficial de Districo (PNG con fondo transparente, petróleo #003647). */
  .logo { width: 150px; height: auto; display: block; }
  /* Sobre fondo oscuro el petróleo del logo desaparece: se aclara con un filtro
     en vez de mantener una segunda versión del archivo. */
  .logo--onDark { filter: brightness(0) invert(1); opacity: 0.95; }
</style>
