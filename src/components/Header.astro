---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { nav, site } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="hdr">
  <div class="container hdr__inner">
    <a href="/" class="hdr__logo"><Logo onDark /></a>

    <nav class="hdr__nav" aria-label="Principal">
      {nav.map((item) => (
        <a href={item.href} class:list={['hdr__link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hdr__cta">
      <Button href="tel:08001004" variant="primary">{site.tollFree}</Button>
    </div>

    <details class="hdr__mobile">
      <summary aria-label="Abrir menú"><span></span><span></span><span></span></summary>
      <div class="hdr__panel">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </details>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Teal institucional exacto del sitio del cliente. Opaco a propósito: con
       transparencia el hero claro lo aclaraba y dejaba de ser #204F5F. */
    background: var(--brand-teal);
    color: var(--white);
    /* Reemplaza al borde gris: el header contrasta 1.41–1.75:1 contra la
       StatsBar y los bloques de línea oscuros, así que sin separación se
       fundiría con ellos al scrollear. La sombra se lee sobre fondo claro
       y oscuro por igual. */
    box-shadow: 0 12px 28px -20px rgb(0 0 0 / 0.75);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 76px;
  }
  .hdr__logo { margin-right: auto; }
  /* El PNG del logo está en negativo: la placa es opaca y las letras son huecos.
     Con onDark la placa se vuelve blanca y las letras toman el teal del header
     (8.96:1). El 0.95 de opacidad que usa el footer acá la ensuciaba de gris. */
  .hdr__logo :global(.logo--onDark) { opacity: 1; }
  .hdr__nav { display: none; gap: 1.75rem; }
  .hdr__link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--white);
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  .hdr__link:hover { color: var(--brand-lime); }
  .hdr__link.is-active { color: var(--white); border-color: var(--brand-lime); }
  .hdr__cta { display: none; }
  /* El botón se pinta acá y no con una variante nueva de Button.astro, para no
     tocar el lima del resto del sitio (--lime-500) desde el header. */
  .hdr__cta :global(.btn) { background: var(--brand-lime); color: #001A22; }
  .hdr__cta :global(.btn:hover) { background: color-mix(in srgb, var(--brand-lime) 82%, var(--white)); }

  /* Menú móvil con <details>: cero JS. */
  .hdr__mobile summary {
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    cursor: pointer;
  }
  .hdr__mobile summary::-webkit-details-marker { display: none; }
  .hdr__mobile summary span {
    display: block;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform var(--dur-move) ease, opacity var(--dur-move) ease;
  }
  .hdr__mobile[open] summary span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hdr__mobile[open] summary span:nth-child(2) { opacity: 0; }
  .hdr__mobile[open] summary span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .hdr__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--brand-teal);
    color: var(--white);
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    padding: 1rem var(--gutter) 1.75rem;
    display: grid;
    gap: 0.25rem;
    box-shadow: var(--shadow-md);
  }
  .hdr__panel a:hover { color: var(--brand-lime); }
  .hdr__mobile summary:hover span { background: var(--brand-lime); }
  .hdr__panel a {
    padding: 0.85rem 0;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }

  @media (min-width: 940px) {
    .hdr__nav, .hdr__cta { display: flex; }
    .hdr__mobile { display: none; }
  }
</style>
