---
import { social } from '../config';

/*
  Las dos redes de Districo. Se usa en el header y en el footer, con la misma
  marca de clase y distinto contexto de color: el ícono hereda currentColor.

  Los enlaces salen a otro sitio, así que van con rel="noopener noreferrer".
  El <a> mide 44x44 aunque el ícono se vea de 20: el área táctil no puede ser
  el tamaño del dibujo.
*/
interface Props { class?: string }
const { class: className = '' } = Astro.props;

const PATHS: Record<string, string> = {
  facebook:
    'M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6.5 0h3.83v1.64h.05c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.14V21h-4v-5.46c0-1.3-.02-2.98-1.81-2.98-1.82 0-2.1 1.42-2.1 2.89V21h-4V9Z',
};
---

<ul class={`soc ${className}`}>
  {social.map((red) => (
    <li>
      <a href={red.href} target="_blank" rel="noopener noreferrer" aria-label={red.label}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d={PATHS[red.icon]} />
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .soc { display: flex; gap: 0.1rem; list-style: none; margin: 0; padding: 0; }
  .soc a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: inherit;
    /* Atenuados a propósito: al lado del botón del 0800, que es el canal de
       venta, no pueden pesar lo mismo. */
    opacity: 0.68;
    transition: opacity var(--dur-fast) ease;
  }
  .soc a:hover,
  .soc a:focus-visible { opacity: 1; }
  .soc a:focus-visible { outline: 2px solid currentColor; outline-offset: -6px; border-radius: 50%; }
</style>
