---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BrandCard from '../../components/BrandCard.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { lineAccent } from '../../config';

const products = await getCollection('products');
const lineas = (await getCollection('lineas')).sort((a, b) => a.data.order - b.data.order);

const brands = (await getCollection('brands'))
  .map((b) => ({
    id: b.id,
    name: b.data.name,
    linea: b.data.categories[0]?.id ?? '',
    count: products.filter((p) => p.data.brand?.id === b.id).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'es'));
---

<Base
  title="Marcas que distribuimos"
  description={`Districo S.A. representa ${brands.length} marcas de alimento para mascotas, arenas sanitarias, cuidado animal y snacks, con stock permanente para comercios de todo Uruguay.`}
>
  <section class="head">
    <div class="container">
      <span class="kicker kicker--accent">Representaciones</span>
      <h1 class="title-xl">Marcas</h1>
      <p class="lead">
        {brands.length} marcas y {products.length} productos con stock permanente en la Casa Matriz.
        Filtrá por línea de negocio.
      </p>
    </div>
  </section>

  <section class="filters" aria-label="Filtro por línea de negocio">
    <div class="container filters__inner">
      <button class="chip is-on" type="button" data-filter-linea="">Todas</button>
      {lineas.map((l) => (
        <button
          class="chip"
          type="button"
          data-filter-linea={l.id}
          style={`--chip:${lineAccent(l.id).color};--chip-fg:${lineAccent(l.id).text}`}
        >
          {l.data.name}
        </button>
      ))}
    </div>
  </section>

  <section class="grid-wrap">
    <div class="container">
      <ul class="grid" id="grid">
        {brands.map((brand, i) => (
          <li data-reveal style={`--reveal-delay:${Math.min(i, 8) * 45}ms`}>
            <BrandCard id={brand.id} name={brand.name} linea={brand.linea} count={brand.count} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBlock />
</Base>

<script>
  // Mismo criterio que /productos: las 21 tarjetas ya están en el HTML y solo se
  // alternan con el atributo hidden. Cero hidratación, cero dependencias.
  const items = [...document.querySelectorAll<HTMLLIElement>('#grid > li')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-linea]')];

  function apply(linea: string, push = true) {
    for (const li of items) {
      const el = li.querySelector<HTMLElement>('[data-brand]');
      li.hidden = Boolean(linea) && el?.dataset.linea !== linea;
    }
    for (const chip of chips) chip.classList.toggle('is-on', chip.dataset.filterLinea === linea);
    if (push) history.replaceState(null, '', linea ? `?linea=${linea}` : location.pathname);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => apply(chip.dataset.filterLinea ?? ''));
  }

  apply(new URLSearchParams(location.search).get('linea') ?? '', false);
</script>

<style>
  .head { padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem; background: var(--bg-soft); }
  .head .kicker { display: block; margin-bottom: 0.5rem; }
  .head h1 { margin-bottom: 0.75rem; }

  .filters {
    position: sticky;
    /* Debajo del header, que también es sticky. */
    top: var(--hdr-h);
    z-index: 20;
    background: color-mix(in srgb, var(--bg-soft) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    padding-block: 1rem;
  }
  .filters__inner { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .chip {
    --chip: var(--teal-800);
    border: 1.5px solid var(--border);
    background: var(--white);
    color: var(--fg-muted);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .chip:hover { border-color: var(--chip); color: color-mix(in srgb, var(--chip) 75%, var(--teal-950)); }
  .chip.is-on { background: var(--chip); border-color: var(--chip); color: var(--chip-fg, #fff); }

  .grid-wrap { padding-block: clamp(2rem, 4vw, 3.5rem) var(--section-y); }
  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(158px, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }
  .grid > li { display: grid; }
  .grid > li[hidden] { display: none; }
</style>
