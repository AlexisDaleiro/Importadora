---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatsBar from '../components/StatsBar.astro';
import CtaBlock from '../components/CtaBlock.astro';
import MilestoneTimeline from '../components/MilestoneTimeline.astro';
import fachada from '../assets/institutional/casa-matriz-fachada.jpg';
import deposito from '../assets/institutional/deposito-estanterias.jpg';
import carga from '../assets/institutional/operacion-carga-camion.jpg';
import electrico from '../assets/institutional/vehiculo-electrico-carga.jpg';
import gimnasio from '../assets/institutional/beneficio-gimnasio.jpg';
import comedor from '../assets/institutional/beneficio-comedor.jpg';
import lavanderia from '../assets/institutional/beneficio-lavanderia.jpg';
import Button from '../components/Button.astro';
import { cvMailto, sucursales } from '../config';
import { valores } from '../data/valores';

// Gimnasio y comedor son fotos de las instalaciones, del sitio oficial. El
// sitio no tiene foto de la lavandería: esa es de Unsplash (Jeremy Sallee,
// unsplash.com/photos/lgrM1t4rxWQ, licencia Unsplash, uso comercial libre).
// `pos` es el object-position del recorte 3:2: la del gimnasio es vertical y
// sin él se ve techo y piso en vez de las máquinas.
const beneficios = [
  {
    titulo: 'Gimnasio',
    texto: 'Gimnasio de última generación, de acceso gratuito para todos los colaboradores.',
    foto: gimnasio,
    alt: 'Gimnasio de Districo con racks de pesas, máquinas y el cartel de Districo Fitness',
    pos: '50% 38%',
  },
  {
    titulo: 'Comedor',
    texto: 'Menús distintos cada día, elaborados con foco en el valor nutricional.',
    foto: comedor,
    alt: 'Comedor del personal con mesa larga, sillas naranjas y cocina al fondo',
    pos: '50% 60%',
  },
  {
    titulo: 'Lavandería',
    texto: 'Servicio de lavado y secado de uniforme de trabajo y ropa de deporte.',
    foto: lavanderia,
    alt: 'Hilera de secadoras industriales de acero',
    pos: '50% 50%',
  },
];

const hitos = (await getCollection('milestones')).sort((a, b) =>
  a.data.year.localeCompare(b.data.year)
);

const infra = [
  { titulo: 'Casa Matriz', dato: '10.000 m²', texto: 'Predio propio en Montevideo con 1.600 m² de depósito, certificado ISO 9001 desde 2019.' },
  { titulo: 'Sucursal Maldonado', dato: '700 m²', texto: 'Sede propia desde la que se atiende el este del país.' },
  { titulo: 'Energía solar', dato: '120 Kw/h', texto: '3 plantas fotovoltaicas propias alimentan la operación.' },
  { titulo: 'Flota eléctrica', dato: '2021', texto: 'Vehículos 100% eléctricos y estaciones de carga propias.' },
];
---

<Base
  title="Quiénes somos"
  description="Historia, misión, valores e infraestructura de Districo S.A., distribuidora uruguaya de alimento y cuidado para mascotas: Casa Matriz de 10.000 m² en Montevideo, certificada ISO 9001, y sucursal propia en Maldonado."
>
  <section class="head">
    <div class="container head__inner">
      <div data-reveal>
        <span class="kicker kicker--accent">Nosotros</span>
        <h1 class="title-xl">Una empresa uruguaya con 30 años de ruta</h1>
        <p class="lead">
          Districo S.A. nace en 1995 como Distribuidora Colón, fundada por Fernando Graviz sobre
          el antecedente de la Agropecuaria Colón que el Ing. Montiel Graviz había iniciado en 1960.
          De la venta de productos agroveterinarios a la distribución nacional de alimento para
          mascotas, arenas sanitarias, cuidado animal y snacks.
        </p>
      </div>
      <div class="head__media" data-reveal style="--reveal-delay:120ms">
        <span class="blob head__blob" aria-hidden="true"></span>
        <Image
          src={fachada}
          alt="Fachada de la Casa Matriz de Districo S.A."
          widths={[480, 760, 1040]}
          sizes="(min-width: 940px) 46vw, 92vw"
          loading="eager"
          class="head__img"
        />
      </div>
    </div>
  </section>

  <StatsBar />

  <section class="hitos section">
    <div class="container">
      <header data-reveal>
        <span class="kicker kicker--accent">Historia</span>
        <h2 class="title-lg">Los hitos de la empresa</h2>
      </header>
      <MilestoneTimeline hitos={hitos.map((h) => ({
        year: h.data.year,
        title: h.data.title,
        description: h.data.description,
      }))} />
    </div>
  </section>

  <section class="cultura" aria-labelledby="cultura-title">
    <div class="container cultura__inner">
      <div class="cultura__quote" data-reveal>
        <span class="kicker kicker--onDark">Nuestra cultura</span>
        <h2 id="cultura-title">
          Nadie es más importante que <em>todos nosotros juntos.</em>
        </h2>
        <p>Una idea que representa cómo elegimos trabajar y crecer cada día.</p>
      </div>
    </div>
  </section>

  <section class="mv" aria-label="Misión y visión">
    <div class="container mv__inner">
      <div class="mv__col" data-reveal>
        <span class="kicker kicker--accent">Nuestra misión</span>
        <p>
          Desarrollar negocios sustentables comercializando productos de distribución masiva,
          trascendiendo y accionando a través de nuestros valores, comprometidos con el
          crecimiento individual y profesional de nuestros colaboradores, buscando la excelencia
          en el servicio a nuestros clientes y procurando mejorar la calidad de vida de todos con
          quienes nos relacionamos.
        </p>
      </div>
      <div class="mv__col" data-reveal style="--reveal-delay:100ms">
        <span class="kicker kicker--accent">Nuestra visión</span>
        <p>
          Ser referentes por nuestro modelo de gestión íntegro e innovador, que transforme
          nuestras acciones en valor para todos con quienes nos vinculamos.
        </p>
      </div>
    </div>
  </section>

  <section class="valores section" aria-labelledby="valores-title">
    <div class="container">
      <header data-reveal>
        <span class="kicker kicker--accent">Nuestros valores</span>
        <h2 id="valores-title" class="title-lg">Nueve acuerdos sobre cómo trabajamos</h2>
      </header>
      {/* Lista de dos columnas y no grilla de tarjetas: con nueve ítems la
          grilla ocupa demasiado alto y obliga a recortar las definiciones, que
          son texto institucional y van completas. */}
      <dl class="valores__lista">
        {valores.map((v, i) => (
          <div class="valores__fila" data-reveal style={`--reveal-delay:${Math.min(i, 5) * 60}ms`}>
            <dt>{v.nombre}</dt>
            <dd>{v.definicion}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="trabaja" aria-labelledby="trabaja-title">
    <div class="trabaja__head">
      <div class="container" data-reveal>
        <span class="kicker kicker--onDark">Trabajá con nosotros</span>
        <h2 id="trabaja-title">
          Ninguna empresa puede ser mejor que las personas que trabajan en ella
        </h2>
        <p>
          Promovemos el cuidado de la salud, la actividad física, la alimentación saludable y la
          formación continua de quienes trabajan acá.
        </p>
      </div>
    </div>

    <div class="container trabaja__cuerpo">
      <ul class="trabaja__grid">
        {beneficios.map((b, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <Image
              src={b.foto}
              alt={b.alt}
              width={720}
              height={480}
              widths={[360, 540, 720]}
              sizes="(min-width: 1440px) 440px, (min-width: 940px) 30vw, (min-width: 600px) 46vw, 92vw"
              loading="lazy"
              style={`object-position:${b.pos}`}
            />
            <div class="trabaja__texto">
              <h3>{b.titulo}</h3>
              <p>{b.texto}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="trabaja__cta" data-reveal>
        <Button href={cvMailto()} variant="primary" size="lg">Enviar mi CV</Button>
        <p>Casa Matriz en Montevideo y sucursal propia en Maldonado.</p>
      </div>
    </div>
  </section>

  <section class="infra">
    <div class="container">
      <header data-reveal>
        <span class="kicker kicker--onDark">Infraestructura</span>
        <h2 class="title-lg">La operación</h2>
      </header>
      <ul class="infra__grid">
        {infra.map((item, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <strong>{item.dato}</strong>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </li>
        ))}
      </ul>
      <p class="infra__foot" data-reveal>
        {sucursales.length} sedes físicas: Casa Matriz en Montevideo y sucursal en Maldonado. La distribución alcanza todo Uruguay.
      </p>
    </div>
  </section>

  <section class="galeria section">
    <div class="container">
      <ul class="galeria__grid">
        {[
          { src: deposito, alt: 'Estanterías del depósito de Districo' },
          { src: carga, alt: 'Carga de mercadería en camión' },
          { src: electrico, alt: 'Vehículo eléctrico de reparto cargando' },
        ].map((foto, i) => (
          <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <Image src={foto.src} alt={foto.alt} widths={[420, 700]} sizes="(min-width: 760px) 33vw, 92vw" loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBlock />
</Base>

<style>
  .head { padding-block: var(--section-y-xs); background: var(--bg-soft); overflow: hidden; }
  .head__inner { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  .head .kicker { display: block; margin-bottom: 0.5rem; }
  .head h1 { margin-bottom: 0.85rem; }
  .head__media { position: relative; display: grid; place-items: center; }
  .head__blob { width: min(80%, 420px); aspect-ratio: 1; background: var(--lime-500); top: -8%; right: -5%; }
  .head__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .hitos header { margin-bottom: 2rem; }
  .hitos header .kicker { display: block; margin-bottom: 0.5rem; }

  .cultura { background: var(--teal-900); color: var(--white); }
  .cultura__inner { display: grid; }
  .cultura__quote {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--section-y-sm);
  }
  .cultura__quote .kicker { display: block; margin-bottom: 0.65rem; }
  .cultura__quote h2 {
    max-width: 18ch;
    font-size: clamp(2.2rem, 6vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .cultura__quote h2 em { color: var(--lime-500); font-style: normal; }
  .cultura__quote p { max-width: 48ch; margin-top: 1.25rem; color: rgb(255 255 255 / 0.68); }
  /* ── Misión y visión ──────────────────────────────────────────────────
     Fondo claro único: el salto desde el teal de cultura ya separa las
     secciones, sin línea. Columnas centradas en la fila para que la visión,
     más corta, no quede colgada arriba; cada barra lima es un borde de su
     propia columna, así mide el alto de su texto y no el de la fila. */
  .mv { background: var(--bg-soft); color: var(--fg); padding-block: var(--section-y-sm); }
  .mv__inner { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  .mv__col { border-left: 3px solid var(--lime-500); padding-left: clamp(1.25rem, 2.5vw, 2rem); }
  .mv__col .kicker { display: block; margin-bottom: 1rem; }
  .mv__col p { font-size: var(--text-lg); max-width: 52ch; text-wrap: pretty; color: var(--fg-muted); }

  /* ── Valores ──────────────────────────────────────────────────────────
     dt/dd en dos columnas: nombre a la izquierda con ancho fijo, definición a
     la derecha, y una línea fina entre filas. */
  .valores header { margin-bottom: 2rem; }
  .valores header .kicker { display: block; margin-bottom: 0.5rem; }
  .valores__lista { margin: 0; }
  .valores__fila {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--border);
  }
  .valores__fila:last-child { border-bottom: 1px solid var(--border); }
  .valores__fila dt { font-weight: 800; letter-spacing: -0.02em; color: var(--fg); }
  .valores__fila dd { margin: 0; color: var(--fg-muted); max-width: 70ch; }

  /* ── Trabajá con nosotros ─────────────────────────────────────────── */
  .trabaja__head {
    background: var(--teal-950);
    color: var(--white);
    padding-block: var(--section-y-sm);
  }
  .trabaja__head .kicker { display: block; margin-bottom: 0.75rem; }
  .trabaja__head h2 {
    max-width: 20ch;
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .trabaja__head p { margin-top: 1.25rem; max-width: 58ch; color: rgb(255 255 255 / 0.72); }
  .trabaja__cuerpo { padding-block: var(--section-y-sm); }
  /* grid-auto-rows 1fr y no solo el stretch de la fila: en tablet la tercera
     tarjeta cae sola en otra fila y tiene que medir lo mismo que las dos de
     arriba. */
  .trabaja__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .trabaja__grid li {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--bd) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
  }
  .trabaja__grid img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .trabaja__texto { padding: 1.25rem 1.35rem 1.5rem; }
  .trabaja__grid h3 { font-size: var(--text-lg); letter-spacing: -0.025em; margin-bottom: 0.5rem; }
  .trabaja__grid p { color: var(--fg-muted); font-size: var(--text-sm); }
  .trabaja__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }
  .trabaja__cta p { color: var(--fg-muted); font-size: var(--text-sm); margin: 0; max-width: 40ch; }

  .infra { background: var(--teal-900); color: var(--white); padding-block: var(--section-y-sm); }
  .infra header { margin-bottom: 2rem; }
  .infra header .kicker { display: block; margin-bottom: 0.5rem; }
  .infra__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  .infra__grid li {
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.25rem;
  }
  .infra__grid strong {
    display: block;
    font-size: var(--text-2xl);
    color: var(--lime-500);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 0.6rem;
  }
  .infra__grid h3 { font-size: var(--text-base); margin-bottom: 0.35rem; }
  .infra__grid p { color: rgb(255 255 255 / 0.68); font-size: var(--text-sm); }
  .infra__foot { margin-top: 1.5rem; color: rgb(255 255 255 / 0.68); font-size: var(--text-sm); }

  .galeria__grid { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  .galeria__grid img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 760px) {
    .galeria__grid { grid-template-columns: repeat(3, 1fr); }
    .mv__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    /* Nombre a la izquierda con ancho fijo, definición a la derecha. */
    .valores__fila { grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: 2rem; align-items: baseline; }
    .cultura__inner { grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr); }
    .cultura__quote { padding-right: clamp(2rem, 6vw, 5rem); }
  }
  @media (min-width: 600px) {
    .trabaja__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 940px) {
    .head__inner { grid-template-columns: 1.05fr 0.95fr; }
    .trabaja__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
