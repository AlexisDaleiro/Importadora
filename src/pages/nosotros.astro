---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatsBar from '../components/StatsBar.astro';
import CtaBlock from '../components/CtaBlock.astro';
import MilestoneTimeline from '../components/MilestoneTimeline.astro';
import fachada from '../assets/institutional/casa-matriz-fachada.jpg';
import deposito from '../assets/institutional/deposito-estanterias.jpg';
import carga from '../assets/institutional/operacion-carga-camion.jpg';
import electrico from '../assets/institutional/vehiculo-electrico-carga.jpg';
import { centrosRegionales, sucursales } from '../config';

const hitos = (await getCollection('milestones')).sort((a, b) =>
  a.data.year.localeCompare(b.data.year)
);

const infra = [
  { titulo: 'Casa Matriz', dato: '6.000 m²', texto: 'Depósito y oficinas en Montevideo, certificados ISO 9001 desde 2019.' },
  { titulo: 'Sucursal Maldonado', dato: '400 m²', texto: 'Abastece al este del país junto a los centros regionales.' },
  { titulo: 'Energía solar', dato: '120 Kw/h', texto: '3 plantas fotovoltaicas propias alimentan la operación.' },
  { titulo: 'Flota eléctrica', dato: '2021', texto: 'Vehículos 100% eléctricos y estaciones de carga propias.' },
];

// Contenido demostrativo para presentar la propuesta. Sustituir por datos,
// nombres, testimonios y novedades aprobados por Districo antes de producción.
const historiasEquipo = [
  {
    kicker: 'Preparación y depósito',
    titulo: 'El equipo que prepara cada entrega',
    texto: 'Recepción, control y armado de pedidos se coordinan para que cada producto salga en condiciones y a tiempo.',
  },
  {
    kicker: 'Distribución nacional',
    titulo: 'Personas que recorren el país',
    texto: 'Choferes y equipos regionales sostienen el vínculo cotidiano con comercios de distintos puntos de Uruguay.',
  },
];

const novedadesEquipo = [
  { tipo: 'Reconocimiento', titulo: 'Celebramos a quienes cumplieron 10 años en Districo' },
  { tipo: 'Capacitación', titulo: 'Nueva jornada de seguridad y calidad para nuestros equipos' },
  { tipo: 'Encuentro', titulo: 'Montevideo y Maldonado compartieron una jornada de trabajo' },
];
---

<Base
  title="Quiénes somos"
  description="Historia, infraestructura y certificación ISO 9001 de Districo S.A., distribuidora uruguaya de alimento y cuidado para mascotas con Casa Matriz de 6.000 m² en Montevideo."
>
  <section class="head">
    <div class="container head__inner">
      <div data-reveal>
        <span class="kicker kicker--accent">Nosotros</span>
        <h1 class="title-xl">Una empresa uruguaya con 30 años de ruta</h1>
        <p class="lead">
          Districo S.A. nace en 1995 como Distribuidora Colón, fundada por Fernando Graviz sobre
          el antecedente de la Agropecuaria Colón que el Ing. Montiel Graviz había iniciado en 1960.
          De la venta de productos agroveterinarios a la distribución nacional de alimento para
          mascotas, arenas sanitarias, cuidado animal y snacks.
        </p>
      </div>
      <div class="head__media" data-reveal style="--reveal-delay:120ms">
        <span class="blob head__blob" aria-hidden="true"></span>
        <Image
          src={fachada}
          alt="Fachada de la Casa Matriz de Districo S.A."
          widths={[480, 760, 1040]}
          sizes="(min-width: 940px) 46vw, 92vw"
          loading="eager"
          class="head__img"
        />
      </div>
    </div>
  </section>

  <StatsBar />

  <section class="hitos section">
    <div class="container">
      <header data-reveal>
        <span class="kicker kicker--accent">Historia</span>
        <h2 class="title-lg">Los hitos de la empresa</h2>
      </header>
      <MilestoneTimeline hitos={hitos.map((h) => ({
        year: h.data.year,
        title: h.data.title,
        description: h.data.description,
      }))} />
    </div>
  </section>

  <section class="cultura" aria-labelledby="cultura-title">
    <div class="container cultura__inner">
      <div class="cultura__quote" data-reveal>
        <span class="kicker kicker--onDark">Nuestra cultura</span>
        <h2 id="cultura-title">
          Nadie es más importante que <em>todos nosotros juntos.</em>
        </h2>
        <p>Una idea que representa cómo elegimos trabajar y crecer cada día.</p>
      </div>
      <div class="cultura__stat" data-reveal style="--reveal-delay:100ms" data-demo-content="true">
        <strong>150</strong>
        <span>colaboradores</span>
        <small>Cifra ilustrativa para esta propuesta</small>
      </div>
    </div>
  </section>

  <section class="equipo section" aria-labelledby="equipo-title" data-demo-content="true">
    <div class="container">
      <header class="equipo__header" data-reveal>
        <div>
          <span class="kicker kicker--accent">Nuestro equipo</span>
          <h2 id="equipo-title" class="title-lg">Personas que hacen que todo llegue</h2>
        </div>
        <span class="demo-note">Contenido de muestra</span>
      </header>

      <div class="equipo__layout">
        <article class="historia-principal" data-reveal>
          <div class="historia-principal__media">
            <Image
              src={carga}
              alt="Equipo de Districo durante la carga de mercadería"
              widths={[520, 820, 1100]}
              sizes="(min-width: 940px) 58vw, 92vw"
              loading="lazy"
            />
          </div>
          <div class="historia-principal__body">
            <span class="kicker kicker--accent">Historia destacada</span>
            <h3>Mariana Silva — 12 años conectando equipos y clientes</h3>
            <p>
              Desde coordinación comercial, Mariana acompaña el trabajo entre ventas, depósito y
              distribución. Su historia representa a quienes convierten una operación grande en un
              servicio cercano todos los días.
            </p>
            <span class="historia-principal__meta">Nombre e historia ficticios para la maqueta</span>
          </div>
        </article>

        <div class="historias-secundarias">
          {historiasEquipo.map((historia, i) => (
            <article data-reveal style={`--reveal-delay:${(i + 1) * 80}ms`}>
              <span class="kicker kicker--accent">{historia.kicker}</span>
              <h3>{historia.titulo}</h3>
              <p>{historia.texto}</p>
              <span class="historias-secundarias__link">Conocer esta historia</span>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="novedades section" aria-labelledby="novedades-title" data-demo-content="true">
    <div class="container">
      <header data-reveal>
        <span class="kicker kicker--accent">La vida en Districo</span>
        <h2 id="novedades-title" class="title-lg">Novedades de nuestro equipo</h2>
        <p>Reconocimientos, aprendizajes y encuentros que también forman parte de la empresa.</p>
      </header>
      <ul class="novedades__grid">
        {novedadesEquipo.map((novedad, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span>{novedad.tipo}</span>
            <h3>{novedad.titulo}</h3>
            <small>Ejemplo de contenido</small>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="infra">
    <div class="container">
      <header data-reveal>
        <span class="kicker kicker--onDark">Infraestructura</span>
        <h2 class="title-lg">La operación</h2>
      </header>
      <ul class="infra__grid">
        {infra.map((item, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <strong>{item.dato}</strong>
            <h3>{item.titulo}</h3>
            <p>{item.texto}</p>
          </li>
        ))}
      </ul>
      <p class="infra__foot" data-reveal>
        Centros regionales en {centrosRegionales.join(', ')}, más las {sucursales.length} sedes propias.
      </p>
    </div>
  </section>

  <section class="galeria section">
    <div class="container">
      <ul class="galeria__grid">
        {[
          { src: deposito, alt: 'Estanterías del depósito de Districo' },
          { src: carga, alt: 'Carga de mercadería en camión' },
          { src: electrico, alt: 'Vehículo eléctrico de reparto cargando' },
        ].map((foto, i) => (
          <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <Image src={foto.src} alt={foto.alt} widths={[420, 700]} sizes="(min-width: 760px) 33vw, 92vw" loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBlock />
</Base>

<style>
  .head { padding-block: var(--section-y-xs); background: var(--bg-soft); overflow: hidden; }
  .head__inner { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  .head .kicker { display: block; margin-bottom: 0.5rem; }
  .head h1 { margin-bottom: 0.85rem; }
  .head__media { position: relative; display: grid; place-items: center; }
  .head__blob { width: min(80%, 420px); aspect-ratio: 1; background: var(--lime-500); top: -8%; right: -5%; }
  .head__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .hitos header { margin-bottom: 2rem; }
  .hitos header .kicker { display: block; margin-bottom: 0.5rem; }

  .cultura { background: var(--teal-900); color: var(--white); }
  .cultura__inner { display: grid; }
  .cultura__quote {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--section-y-sm);
  }
  .cultura__quote .kicker { display: block; margin-bottom: 0.65rem; }
  .cultura__quote h2 {
    max-width: 18ch;
    font-size: clamp(2.2rem, 6vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .cultura__quote h2 em { color: var(--lime-500); font-style: normal; }
  .cultura__quote p { max-width: 48ch; margin-top: 1.25rem; color: rgb(255 255 255 / 0.68); }
  .cultura__stat {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 15rem;
    padding: 2rem;
    background: var(--lime-500);
    color: var(--teal-950);
  }
  .cultura__stat strong {
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 0.78;
    letter-spacing: -0.075em;
  }
  .cultura__stat span { margin-top: 1.1rem; font-size: var(--text-lg); font-weight: 800; }
  .cultura__stat small { margin-top: 0.45rem; color: rgb(7 51 63 / 0.7); }

  .equipo__header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .equipo__header .kicker,
  .novedades header .kicker { display: block; margin-bottom: 0.5rem; }
  .demo-note {
    border: var(--bd) solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.7rem;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .equipo__layout { display: grid; gap: 1rem; }
  .historia-principal {
    overflow: hidden;
    border: var(--bd) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .historia-principal__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .historia-principal__body { padding: clamp(1.35rem, 3vw, 2rem); }
  .historia-principal__body .kicker { display: block; margin-bottom: 0.55rem; }
  .historia-principal__body h3 {
    max-width: 25ch;
    margin-bottom: 0.75rem;
    font-size: var(--text-xl);
    letter-spacing: -0.035em;
  }
  .historia-principal__body p { max-width: 60ch; color: var(--fg-muted); }
  .historia-principal__meta {
    display: block;
    margin-top: 1rem;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    font-style: italic;
  }
  .historias-secundarias { display: grid; gap: 1rem; }
  .historias-secundarias article {
    display: flex;
    flex-direction: column;
    min-height: 14rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
  }
  .historias-secundarias .kicker { display: block; margin-bottom: 0.75rem; }
  .historias-secundarias h3 { margin-bottom: 0.65rem; font-size: var(--text-lg); letter-spacing: -0.025em; }
  .historias-secundarias p { color: var(--fg-muted); }
  .historias-secundarias__link {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--teal-700);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .novedades { padding-top: 0; }
  .novedades header { margin-bottom: 2rem; }
  .novedades header > p { max-width: 60ch; margin-top: 0.75rem; color: var(--fg-muted); }
  .novedades__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }
  .novedades__grid li {
    min-height: 12rem;
    padding: 1.4rem;
    border-top: 0.3rem solid var(--lime-500);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--bg-soft);
  }
  .novedades__grid li > span {
    color: var(--teal-700);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .novedades__grid h3 { margin-top: 1rem; font-size: var(--text-lg); letter-spacing: -0.025em; }
  .novedades__grid small { display: block; margin-top: 1.5rem; color: var(--fg-muted); }

  .infra { background: var(--teal-900); color: var(--white); padding-block: var(--section-y-sm); }
  .infra header { margin-bottom: 2rem; }
  .infra header .kicker { display: block; margin-bottom: 0.5rem; }
  .infra__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  .infra__grid li {
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.25rem;
  }
  .infra__grid strong {
    display: block;
    font-size: var(--text-2xl);
    color: var(--lime-500);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 0.6rem;
  }
  .infra__grid h3 { font-size: var(--text-base); margin-bottom: 0.35rem; }
  .infra__grid p { color: rgb(255 255 255 / 0.68); font-size: var(--text-sm); }
  .infra__foot { margin-top: 1.5rem; color: rgb(255 255 255 / 0.68); font-size: var(--text-sm); }

  .galeria__grid { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  .galeria__grid img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 760px) {
    .galeria__grid { grid-template-columns: repeat(3, 1fr); }
    .cultura__inner { grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr); }
    .cultura__quote { padding-right: clamp(2rem, 6vw, 5rem); }
    .novedades__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 940px) {
    .head__inner { grid-template-columns: 1.05fr 0.95fr; }
    .equipo__layout { grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr); }
  }
</style>
