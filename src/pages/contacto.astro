---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { contactLink, formspreeUrl, site, sucursales } from '../config';
---

<Base
  title="Contacto y sucursales"
  description="Escribinos para abrir cuenta mayorista con Districo S.A. Casa Matriz en Montevideo, sucursal en Maldonado y línea gratuita 0800 1004."
>
  <section class="head">
    <div class="container">
      <span class="kicker kicker--accent">Contacto</span>
      <h1 class="title-xl">Hablemos de tu comercio</h1>
      <p class="lead">
        Atendemos veterinarias, pet shops, agropecuarias y grandes superficies de todo el país.
        Escribinos y un vendedor de tu zona se pone en contacto.
      </p>
    </div>
  </section>

  <section class="wrap container">
    <form class="form" id="form" data-reveal>
      {/* Honeypot: campo invisible que los humanos nunca completan. Formspree
          descarta el envío si viene lleno. */}
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      {/* Asunto con el que llega el mail a la casilla de Districo. */}
      <input type="hidden" name="_subject" value="Consulta desde el sitio web" />
      <div class="row">
        <label class="field">
          <span>Nombre y apellido *</span>
          <input name="nombre" type="text" required autocomplete="name" />
        </label>
        <label class="field">
          <span>Comercio</span>
          <input name="comercio" type="text" autocomplete="organization" />
        </label>
      </div>

      <div class="row">
        <label class="field">
          <span>Email *</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span>Teléfono</span>
          <input name="telefono" type="tel" autocomplete="tel" />
        </label>
      </div>

      <label class="field">
        <span>Localidad</span>
        <input name="localidad" type="text" autocomplete="address-level2" />
      </label>

      <label class="field">
        <span>Consulta *</span>
        <textarea name="mensaje" rows="5" required></textarea>
      </label>

      <div class="form__foot">
        <Button type="submit" variant="primary" size="lg" id="form-submit">Enviar consulta</Button>
        <p class="form__note">
          Te respondemos por correo a la brevedad. También podés escribirnos a {site.email}.
        </p>
      </div>

      <p class="form__msg form__msg--ok" id="form-ok" role="status" hidden>
        Consulta enviada. Un vendedor de tu zona se pone en contacto.
      </p>
      <p class="form__msg form__msg--error" id="form-error" role="alert" hidden></p>
    </form>

    <aside class="side" data-reveal style="--reveal-delay:110ms">
      <div class="side__box">
        <h2>Directo</h2>
        <p><a class="side__big" href="tel:08001004">{site.tollFree}</a></p>
        <p><a href={`tel:${site.phone.replace(/[^0-9+]/g, '')}`}>{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <div class="actions">
          <Button href={contactLink()} variant="lime">WhatsApp</Button>
        </div>
      </div>
    </aside>
  </section>

  <section class="sedes section">
    <div class="container">
      <h2 class="title-lg" data-reveal>Nuestras sedes</h2>
      <ul class="sedes__grid">
        {sucursales.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <div class="sede__info">
              <h3>{s.nombre}</h3>
              <p class="sede__sup">{s.superficie}</p>
              <p>{s.direccion}</p>
              {s.telefonos.map((t) => (
                <p><a href={`tel:${t.replace(/[^0-9+]/g, '')}`}>{t}</a></p>
              ))}
            </div>
            <iframe
              class="sede__mapa"
              src={s.mapa}
              title={`Mapa de ${s.nombre}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ endpoint: formspreeUrl }}>
  // Envío real vía Formspree: no hace falta backend propio en Vercel.
  // El ID del form se configura en src/config.ts (FORMSPREE_ID).
  const form = document.getElementById('form');
  const btn = document.getElementById('form-submit');
  const ok = document.getElementById('form-ok');
  const error = document.getElementById('form-error');
  const btnTexto = btn.textContent;

  function fallo(msg) {
    error.textContent = msg;
    error.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    ok.hidden = true;
    error.hidden = true;

    // Validación nativa: required y type="email" ya marcan campo por campo.
    if (!form.reportValidity()) return;

    btn.disabled = true;
    btn.textContent = 'Enviando…';

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      ok.hidden = false;
    } catch {
      fallo('No pudimos enviar la consulta. Probá de nuevo o escribinos por WhatsApp.');
    } finally {
      btn.disabled = false;
      btn.textContent = btnTexto;
    }
  });
</script>

<style>
  .head { padding-block: var(--section-y-xs); background: var(--bg-soft); }
  .head .kicker { display: block; margin-bottom: 0.5rem; }
  .head h1 { margin-bottom: 0.75rem; }

  .wrap { display: grid; gap: clamp(2rem, 4vw, 3rem); padding-block: clamp(2.5rem, 5vw, 4rem); align-items: start; }

  .form { display: grid; gap: 1rem; }
  .row { display: grid; gap: 1rem; }
  .field { display: grid; gap: 0.35rem; font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-muted); }
  .field input, .field textarea {
    font: inherit;
    font-size: var(--text-base);
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: var(--fg);
    background: var(--white);
    border: var(--bd) solid var(--border);
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
  }
  .field textarea { resize: vertical; }
  .field input:focus-visible, .field textarea:focus-visible { outline: 2px solid var(--teal-600); outline-offset: 1px; }

  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; padding-top: 0.5rem; }
  .form__note { font-size: var(--text-sm); color: var(--fg-muted); max-width: 34ch; }
  /* Honeypot: fuera de la vista y del tab order, sin display:none (algunos bots lo detectan). */
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .form__msg {
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
  }
  .form__msg--ok { color: var(--teal-900); background: color-mix(in srgb, var(--lime-500) 22%, transparent); }
  .form__msg--error { color: #B3261E; background: color-mix(in srgb, #B3261E 8%, transparent); }


  .side__box {
    background: var(--teal-900);
    color: var(--white);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: grid;
    gap: 0.5rem;
  }
  .side__box h2 { font-size: var(--text-kicker); text-transform: uppercase; letter-spacing: 0.12em; color: rgb(255 255 255 / 0.6); margin-bottom: 0.5rem; }
  .side__box a { color: var(--white); text-decoration: none; }
  .side__box a:hover { text-decoration: underline; }
  .side__big { font-size: var(--text-2xl); font-weight: 800; letter-spacing: -0.03em; color: var(--lime-500) !important; }
  .side__box .actions { margin-top: 1rem; }

  .sedes { background: var(--bg-soft); }
  .sedes h2 { margin-bottom: 1.5rem; }
  .sedes__grid { list-style: none; padding: 0; display: grid; gap: 1.5rem; }
  .sedes__grid li {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
  }
  .sede__info { padding: 1.5rem; display: grid; gap: 0.3rem; align-content: start; }
  .sede__info h3 { font-size: var(--text-xl); letter-spacing: -0.02em; }
  .sede__sup { font-size: var(--text-kicker); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--teal-600); }
  .sede__info p { color: var(--fg-muted); }
  .sede__info a { color: var(--teal-700); font-weight: 600; text-decoration: none; }
  .sede__info a:hover { text-decoration: underline; }
  .sede__mapa { width: 100%; min-height: 240px; border: 0; display: block; }

  @media (min-width: 760px) {
    .row { grid-template-columns: 1fr 1fr; }
    .sedes__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 940px) {
    .wrap { grid-template-columns: 1.4fr 0.6fr; }
  }
</style>
