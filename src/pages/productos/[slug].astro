---
import { Image, getImage } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import ProductCard from '../../components/ProductCard.astro';
import { contactLink, formspreeB2bListo, formspreeB2bUrl, lineAccent, site } from '../../config';
import { normalizarTecnica } from '../../lib/tabla-tecnica';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const brands = await getCollection('brands');
  const lineas = await getCollection('lineas');

  return products.map((product) => {
    const brand = brands.find((b) => b.id === product.data.brand?.id) ?? null;
    const linea = lineas.find((l) => l.id === product.data.category.id)!;
    const related = products
      .filter(
        (p) =>
          p.id !== product.id &&
          (p.data.brand?.id === product.data.brand?.id ||
            p.data.subcategory === product.data.subcategory) &&
          p.data.category.id === product.data.category.id
      )
      .slice(0, 4);
    return { params: { slug: product.id }, props: { product, brand, linea, related } };
  });
}

interface Props {
  product: CollectionEntry<'products'>;
  brand: CollectionEntry<'brands'> | null;
  linea: CollectionEntry<'lineas'>;
  related: CollectionEntry<'products'>[];
}

const { product, brand, linea, related } = Astro.props;
const d = product.data;
const accent = lineAccent(linea.id);
const gallery = d.gallery.length > 0 ? d.gallery : d.image ? [d.image] : [];
// Mensaje del CTA de WhatsApp: nombre del producto + marca, como pide el cliente.
const consulta = `Hola, quisiera consultar por disponibilidad de ${d.name}${brand ? ` (${brand.data.name})` : ''}`;

// La mayoría de los nombres ya arrancan con la marca ("BIOFRESH para gatos"):
// solo se agrega cuando no está, para no repetirla en el <title>.
const tituloFicha =
  brand && !d.name.toLowerCase().includes(brand.data.name.toLowerCase())
    ? `${d.name} — ${brand.data.name}`
    : d.name;

// Al compartir la ficha, la preview usa la foto del producto en vez del og.png del sitio.
const ogProducto = gallery[0]
  ? (await getImage({ src: gallery[0], width: 1200, format: 'png' })).src
  : undefined;
---

<Base
  title={tituloFicha}
  description={
    d.shortDescription?.slice(0, 300) ??
    `${d.name}${brand ? ` de ${brand.data.name}` : ''}: ${linea.data.name.toLowerCase()} que Districo S.A. distribuye a comercios de todo Uruguay.`
  }
  image={ogProducto}
  ogType="product"
>
  <nav class="crumbs container" aria-label="Miga de pan">
    <a href="/productos">Productos</a>
    <span aria-hidden="true">/</span>
    <a href={`/productos?linea=${linea.id}`}>{linea.data.name}</a>
    {d.subcategory && (
      <>
        <span aria-hidden="true">/</span>
        <a href={`/productos?linea=${linea.id}&sub=${encodeURIComponent(d.subcategory)}`}>{d.subcategory}</a>
      </>
    )}
  </nav>

  <article class="sheet container" style={`--accent:${accent.color}`}>
    <div class="sheet__media" data-reveal>
      <span class="sheet__ring" aria-hidden="true"></span>
      {gallery[0] && (
        <Image
          src={gallery[0]}
          alt={d.name}
          widths={[420, 700, 980]}
          sizes="(min-width: 940px) 46vw, 90vw"
          loading="eager"
          fetchpriority="high"
          class="sheet__img"
          id="main-img"
        />
      )}

      {gallery.length > 1 && (
        <ul class="sheet__thumbs">
          {gallery.map((img, i) => (
            <li>
              <button type="button" class:list={['thumb', i === 0 && 'is-on']} data-src={img.src} data-i={i}>
                <Image src={img} alt={`${d.name} — imagen ${i + 1}`} widths={[110]} sizes="90px" loading="lazy" />
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="sheet__info" data-reveal style="--reveal-delay:100ms">
      <span class="kicker" style={`color:${accent.color}`}>{linea.data.name}</span>
      <h1 class="title-lg">{d.name}</h1>
      {brand && (
        <p class="sheet__brand">
          Marca <a href={`/marcas/${brand.id}`}>{brand.data.name}</a>
        </p>
      )}

      {d.shortDescription && <p class="lead">{d.shortDescription}</p>}

      {d.benefits.length > 0 && (
        <ul class="sheet__benefits">
          {d.benefits.map((b) => (
            <li><Badge tone="soft" color={accent.color}>{b}</Badge></li>
          ))}
        </ul>
      )}

      {d.presentations.length > 0 && (
        <div class="sheet__pres">
          <h2>Presentaciones</h2>
          <ul>{d.presentations.map((p) => <li>{p}</li>)}</ul>
        </div>
      )}

      <div class="sheet__cta">
        <Button href={contactLink(consulta)} variant="primary" size="lg">Consultar por WhatsApp</Button>
        <Button href="tel:08001004" variant="outline" size="lg">Llamar al {site.tollFree}</Button>
        <Button href={`mailto:${site.email}?subject=${encodeURIComponent(`Consulta: ${d.name}`)}`} variant="outline" size="lg">
          Consultar por correo
        </Button>
      </div>
      <p class="sheet__note">Districo distribuye a comercios; no realiza venta directa al público.</p>
    </div>
  </article>

  {(d.description.length > 0 || d.technicalSheet.length > 0) && (
    <section
      class:list={[
        'detail',
        'container',
        /* Dos columnas solo cuando hay contenido de los dos lados: 52 fichas no
           tienen ficha técnica y con la grilla fija les quedaba media pantalla
           en blanco. */
        d.description.length > 0 && d.technicalSheet.length > 0 && 'detail--dos',
      ]}
    >
      {d.description.length > 0 && (
        <div class="detail__text" data-reveal>
          <h2 class="title-lg">Descripción</h2>
          {d.description.map((p) => <p>{p}</p>)}
        </div>
      )}

      {d.technicalSheet.length > 0 && (
        <div class="detail__tech" data-reveal>
          <h2 class="title-lg">Información técnica</h2>
          {d.technicalSheet.map((block) => (
            <details>
              <summary>{block.label}</summary>
              <div class="tech__body" set:html={normalizarTecnica(block.content)} />
            </details>
          ))}
        </div>
      )}
    </section>
  )}

  {brand && (
    <section class="lead-b2b" style={`--accent:${accent.color};--accent-fg:${accent.text}`}>
      <div class="container lead__inner">
        <div class="lead__intro">
          <span class="kicker lead__kicker">Distribución mayorista</span>
          <h2 class="title-xl lead__title">Quiero vender <span class="lead__marca">{brand.data.name}</span></h2>
          <p class="lead__copy">
            Sumá {brand.data.name} a tu comercio. Dejanos tus datos y un vendedor de tu zona
            te contacta.
          </p>
          <p class="lead__nota">
            Districo distribuye a veterinarias, pet shops, agropecuarias y grandes superficies.
            No hacemos venta directa al público.
          </p>
        </div>

        <form
          class="lead__form"
          id="lead-form"
          data-endpoint={formspreeB2bUrl}
          data-listo={String(formspreeB2bListo())}
        >
          {/* Honeypot: invisible para personas, tentador para bots. */}
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          {/* Contexto de la consulta: Districo tiene que saber por qué marca entró. */}
          <input type="hidden" name="marca" value={brand.data.name} />
          <input type="hidden" name="producto" value={d.name} />
          <input type="hidden" name="origen" value={Astro.url.href} />

          <div class="lead__row">
            <div class="lead__field">
              <label for="lead-nombre">Nombre y apellido *</label>
              <input id="lead-nombre" name="nombre" type="text" required autocomplete="name" />
            </div>
            <div class="lead__field">
              <label for="lead-comercio">Nombre del comercio *</label>
              <input id="lead-comercio" name="comercio" type="text" required autocomplete="organization" />
            </div>
          </div>

          <div class="lead__row">
            <div class="lead__field">
              <label for="lead-tipo">Tipo de comercio</label>
              <select id="lead-tipo" name="tipo">
                <option value="Veterinaria">Veterinaria</option>
                <option value="Pet shop">Pet shop</option>
                <option value="Agropecuaria">Agropecuaria</option>
                <option value="Supermercado">Supermercado</option>
                <option value="Otro">Otro</option>
              </select>
            </div>
            <div class="lead__field">
              <label for="lead-email">Email *</label>
              <input id="lead-email" name="email" type="email" required autocomplete="email" />
            </div>
          </div>

          <div class="lead__row">
            <div class="lead__field">
              <label for="lead-tel">Teléfono</label>
              <input id="lead-tel" name="telefono" type="tel" autocomplete="tel" />
            </div>
            <div class="lead__field">
              <label for="lead-localidad">Localidad / departamento</label>
              <input id="lead-localidad" name="localidad" type="text" autocomplete="address-level2" />
            </div>
          </div>

          <div class="lead__field">
            <label for="lead-mensaje">Mensaje (opcional)</label>
            <textarea id="lead-mensaje" name="mensaje" rows="3"></textarea>
          </div>

          <div class="lead__foot">
            <button type="submit" class="lead__btn" id="lead-btn">Quiero vender {brand.data.name}</button>
            <p class="lead__legal">Te respondemos por correo. No compartimos tus datos.</p>
          </div>

          <p class="lead__msg lead__msg--ok" id="lead-ok" role="status" hidden>
            Consulta enviada. Un vendedor de tu zona se pone en contacto.
          </p>
          <p class="lead__msg lead__msg--error" id="lead-error" role="alert" hidden></p>
        </form>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="related section">
      <div class="container">
        <h2 class="title-lg" data-reveal>También distribuimos</h2>
        <ul class="related__grid">
          {related.map((p) => (
            <li data-reveal><ProductCard product={p} brandName={brand?.data.name} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<script>
  // Galería: una sola imagen grande, las miniaturas solo cambian el src.
  const main = document.getElementById('main-img') as HTMLImageElement | null;
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];
  for (const t of thumbs) {
    t.addEventListener('click', () => {
      const img = t.querySelector('img');
      if (!main || !img) return;
      main.src = img.currentSrc || img.src;
      main.srcset = img.srcset;
      for (const o of thumbs) o.classList.toggle('is-on', o === t);
    });
  }

  // Formulario B2B: mismo criterio que /contacto, POST a Formspree con fetch.
  // Usa su propio form (FORMSPREE_ID_B2B) para que los "quiero vender X" no se
  // mezclen con las consultas generales en la bandeja de Districo.
  const leadForm = document.getElementById('lead-form') as HTMLFormElement | null;
  const leadBtn = document.getElementById('lead-btn') as HTMLButtonElement | null;
  const leadOk = document.getElementById('lead-ok') as HTMLElement | null;
  const leadError = document.getElementById('lead-error') as HTMLElement | null;

  if (leadForm && leadBtn && leadOk && leadError) {
    const endpoint = leadForm.dataset.endpoint ?? '';
    const listo = leadForm.dataset.listo === 'true';
    const btnTexto = leadBtn.textContent;

    leadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      leadOk.hidden = true;
      leadError.hidden = true;

      // Validación nativa: marca campo por campo y anuncia el error.
      if (!leadForm.reportValidity()) return;

      if (!listo) {
        leadError.textContent =
          'El envío todavía no está conectado. Escribinos por WhatsApp o al 0800 1004.';
        leadError.hidden = false;
        return;
      }

      leadBtn.disabled = true;
      leadBtn.textContent = 'Enviando…';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(leadForm),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        leadForm.reset();
        leadOk.hidden = false;
      } catch {
        leadError.textContent =
          'No pudimos enviar la consulta. Probá de nuevo o escribinos por WhatsApp.';
        leadError.hidden = false;
      } finally {
        leadBtn.disabled = false;
        leadBtn.textContent = btnTexto;
      }
    });
  }
</script>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--teal-600); text-decoration: underline; }

  .sheet {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .sheet__media { position: relative; display: grid; justify-items: center; gap: 1rem; }
  .sheet__ring {
    position: absolute;
    top: 0;
    width: min(86%, 460px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    z-index: 0;
  }
  .sheet__img {
    position: relative;
    z-index: 1;
    width: min(80%, 440px);
    height: auto;
    object-fit: contain;
  }
  .sheet__thumbs { position: relative; z-index: 1; display: flex; gap: 0.5rem; list-style: none; padding: 0; }
  .thumb {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    padding: 0.35rem;
    background: var(--gray-50);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .thumb img { width: 100%; height: 100%; object-fit: contain; }
  .thumb.is-on { border-color: var(--accent); }

  .sheet__info > * + * { margin-top: 1.15rem; }
  .sheet__info .kicker { display: block; }
  .sheet__brand { font-size: var(--text-sm); color: var(--fg-muted); }
  .sheet__brand a { color: var(--teal-700); font-weight: 700; }

  .sheet__benefits { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; }

  .sheet__pres h2 {
    font-size: var(--text-kicker);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    margin-bottom: 0.5rem;
  }
  .sheet__pres ul { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; }
  .sheet__pres li {
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 0.45rem 0.9rem;
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .sheet__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; padding-top: 0.5rem; }
  .sheet__note { font-size: var(--text-sm); color: var(--fg-muted); }

  .detail {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--border);
    /* Sin esto las dos columnas se estiran a la misma altura y el borde de la
       más corta marca el hueco. */
    align-items: start;
  }
  .detail > * { max-width: 74ch; }
  .detail__text p { color: var(--fg-muted); margin-top: 1rem; max-width: 62ch; }
  .detail h2 { margin-bottom: 0.5rem; }

  .detail__tech details {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-top: 0.75rem;
    background: var(--bg-soft);
  }
  .detail__tech summary {
    cursor: pointer;
    padding: 0.9rem 1.1rem;
    font-weight: 700;
    list-style: none;
    /* Sin esto, abrir y cerrar rápido cuenta como doble clic y el navegador
       selecciona el texto del título. */
    user-select: none;
    -webkit-user-select: none;
  }
  .detail__tech summary::-webkit-details-marker { display: none; }
  .detail__tech summary::after { content: '+'; float: right; font-size: 1.25rem; line-height: 1; }
  .detail__tech details[open] summary::after { content: '−'; }
  .tech__body {
    padding: 0 1.1rem 1.1rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    overflow-x: auto;
    /* Sombra de scroll: avisa que la tabla sigue a la derecha. Se apoya en el
       fondo del acordeón, así que el degradado sale del mismo --bg-soft. */
    background:
      linear-gradient(to right, var(--bg-soft) 30%, transparent) left / 40px 100% no-repeat local,
      linear-gradient(to left, var(--bg-soft) 30%, transparent) right / 40px 100% no-repeat local,
      radial-gradient(farthest-side at 0 50%, rgb(4 25 29 / 0.16), transparent) left / 14px 100% no-repeat scroll,
      radial-gradient(farthest-side at 100% 50%, rgb(4 25 29 / 0.16), transparent) right / 14px 100% no-repeat scroll;
  }

  .related { background: var(--bg-soft); }
  .related h2 { margin-bottom: 1.5rem; }
  .related__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 1rem;
  }

  /* ── Bloque de captación B2B ─────────────────────────────────────────
     Toma el acento de la línea del producto. El par color/texto sale de
     lineAccents, así que el amarillo de snacks recibe texto oscuro en vez
     de blanco y el bloque de BIOFRESH se ve distinto al de STACK. */
  .lead-b2b {
    background: var(--accent);
    color: var(--accent-fg);
    padding-block: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }
  .lead__inner { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .lead__kicker { color: color-mix(in srgb, currentColor 72%, transparent); display: block; margin-bottom: 0.75rem; }
  .lead__title { text-transform: uppercase; max-width: 12ch; }
  /* La marca es una etiqueta pegada sobre la caja: el vocabulario de una
     distribuidora, y la misma familia que el sticker rotado del hero.
     Invierte el par del bloque (fondo = texto, texto = fondo), así el contraste
     es el mismo que el del titular sobre el acento y no hay que ajustarlo por
     línea: 12.97:1 en alimento, 10.87:1 en snacks.
     La sombra va dura, sin blur, porque es papel pegado y no una tarjeta. */
  .lead__marca {
    display: inline-block;
    background: var(--accent-fg);
    color: var(--accent);
    padding: 0.04em 0.24em 0.1em;
    border-radius: 0.08em;
    rotate: -1.5deg;
    box-shadow: 0.13em 0.13em 0 color-mix(in srgb, var(--accent-fg) 28%, transparent);
  }
  .lead__copy { font-size: var(--text-lg); max-width: 44ch; margin-top: 1rem; opacity: 0.92; }
  .lead__nota { font-size: var(--text-sm); max-width: 44ch; margin-top: 1rem; opacity: 0.7; }

  .lead__form { display: grid; gap: 0.85rem; }
  .lead__row { display: grid; gap: 0.85rem; }
  .lead__field { display: grid; gap: 0.3rem; }
  .lead__field label {
    font-size: var(--text-kicker);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, currentColor 82%, transparent);
  }
  /* Campos en blanco sólido: es lo único que da contraste sobre los cuatro
     acentos, del teal oscuro al amarillo de snacks. */
  .lead__field input,
  .lead__field select,
  .lead__field textarea {
    font: inherit;
    font-size: var(--text-base);
    color: var(--fg);
    background: var(--white);
    border: 2px solid transparent;
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
    width: 100%;
  }
  .lead__field textarea { resize: vertical; }
  .lead__field input:focus-visible,
  .lead__field select:focus-visible,
  .lead__field textarea:focus-visible {
    outline: 3px solid var(--accent-fg);
    outline-offset: 2px;
  }
  /* Campo inválido tras intentar enviar: el borde acompaña al mensaje. */
  .lead__field input:user-invalid,
  .lead__field textarea:user-invalid { border-color: #B3261E; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .lead__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 0.5rem; }
  .lead__btn {
    border: 0;
    border-radius: 999px;
    background: var(--accent-fg);
    color: var(--accent);
    padding: 1rem 2rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .lead__btn:hover { transform: translateY(-2px); }
  .lead__btn[disabled] { opacity: 0.6; cursor: progress; transform: none; }
  .lead__legal { font-size: var(--text-sm); opacity: 0.7; max-width: 26ch; }

  .lead__msg {
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    background: var(--white);
  }
  .lead__msg--ok { color: #17603A; }
  .lead__msg--error { color: #B3261E; }

  @media (min-width: 760px) {
    .lead__row { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 940px) {
    .sheet { grid-template-columns: 1fr 1fr; }
    .lead__inner { grid-template-columns: 0.85fr 1.15fr; }
    /* Descripción a la izquierda, ficha técnica a la derecha. La técnica se
       lleva la columna ancha porque es la que manda la altura: acorta el bloque
       y deja el formulario "Quiero vender <marca>" mucho más arriba. */
    .detail--dos { grid-template-columns: 0.85fr 1.15fr; }
    .detail--dos > * { max-width: none; }
  }
</style>

<style is:global>
  /* El HTML técnico viene del sitio oficial y se normaliza en build con
     src/lib/tabla-tecnica.ts: acá las tablas ya llegan con <th scope> y con
     todas las filas del mismo largo. */
  .tech__body table {
    /* min-width en vez de width:100%: sin esto una tabla de 7 columnas se
       comprime hasta partir "Apolo Adulto" en tres líneas en lugar de scrollear. */
    min-width: max-content;
    border-collapse: collapse;
    margin-top: 0.5rem;
  }
  .tech__body th,
  .tech__body td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }
  .tech__body thead th {
    background: var(--gray-100);
    font-weight: 700;
    color: var(--fg);
    white-space: nowrap;
  }
