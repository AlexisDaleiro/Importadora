---
import Base from '../layouts/Base.astro';
import BannerCarousel from '../components/BannerCarousel.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import LineBlocks from '../components/LineBlocks.astro';
import BrandGrid from '../components/BrandGrid.astro';
import AboutBlock from '../components/AboutBlock.astro';
import CtaBlock from '../components/CtaBlock.astro';
---

<Base
  title="Districo S.A. — Distribuidora de alimento y cuidado para mascotas en Uruguay"
  description="Distribuidora mayorista uruguaya de alimento balanceado, arenas sanitarias, cuidado animal y snacks. 156 productos de 21 marcas, con reparto en todo el país."
>
  <BannerCarousel />
  <Hero />
  <StatsBar />
  <LineBlocks />
  <BrandGrid />
  <AboutBlock />
  <CtaBlock />
</Base>
